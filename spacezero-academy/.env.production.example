NODE_ENV=production
DATABASE_URL=postgresql://USER:CHANGE_ME@HOST:5432/academy?schema=public
APP_ORIGIN=https://academy.example.invalid
SMTP_HOST=smtp.gmail.com
# Alternative to SMTP: Resend API (takes precedence when configured).
RESEND_API_KEY=
RESEND_FROM=
# Optional email-link origin override; defaults to APP_ORIGIN.
ACCOUNT_EMAIL_ORIGIN=
SMTP_PORT=587
SMTP_FROM=SpaceZero Workspace <ali@above9.travel>
SMTP_USER=ali@above9.travel
SMTP_PASSWORD=
STORAGE_ROOT=/srv/spacezero/private-storage
UPLOAD_ROOT=/srv/spacezero/private-uploads
HOST=0.0.0.0
PORT=3000
# Docker supplies /usr/bin/ffprobe; omit locally to use ffprobe-static.
FFPROBE_PATH=/usr/bin/ffprobe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CREDENTIAL_ENCRYPTION_KEY=
