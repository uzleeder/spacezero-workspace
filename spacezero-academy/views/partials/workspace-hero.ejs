<section class="workspace-hero">
  <div class="hero-copy">
    <div class="eyebrow"><span></span> THE ABOVE9 STANDARD</div>
    <h2>Extraordinary service.<br>Starts with you.</h2>
    <p>Build the knowledge. Put it into practice.<br>Make every client experience exceptional.</p>
    <a href="<%= profile.role === 'ADMIN' ? '/admin/training' : '/training' %>" class="btn hero-btn"><%= profile.role === 'ADMIN' ? 'Manage training' : 'Explore my training' %> <span aria-hidden="true">↗</span></a>
  </div>
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 400 270" fill="none" focusable="false">
      <defs>
        <linearGradient id="workspace-mark-blue" x1="95" y1="40" x2="310" y2="230" gradientUnits="userSpaceOnUse">
          <stop stop-color="#7fb3ff"/>
          <stop offset="1" stop-color="#3f6fd6"/>
        </linearGradient>
      </defs>
      <!-- The real SpaceZero mark: an open ring with a paper plane crossing its gap, as in the logo. -->
      <g class="brand-globe">
        <path class="globe-ring" d="M254 46.4A100 100 0 1 1 290.6 183"/>
        <g transform="translate(300.6,107.1) rotate(-45) scale(1.9)">
          <path class="brand-plane" d="M21 0C21-1 19-2 16-2L3-3-9-17-15-17-8-3-19-2-24-7-27-7-24 0-27 7-24 7-19 2-8 3-15 17-9 17 3 3 16 2C19 2 21 1 21 0Z"/>
        </g>
      </g>
    </svg>
    <div class="hero-coordinate">KNOWLEDGE → CONFIDENCE → EXCELLENCE</div>
  </div>
</section>
