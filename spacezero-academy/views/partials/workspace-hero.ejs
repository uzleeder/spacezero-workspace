<section class="workspace-hero">
  <div class="hero-copy">
    <div class="eyebrow"><span></span> THE ABOVE9 STANDARD</div>
    <h2>Extraordinary service.<br>Starts with you.</h2>
    <p>Build the knowledge. Put it into practice.<br>Make every client experience exceptional.</p>
    <a href="<%= profile.role === 'ADMIN' ? '/admin/training' : '/training' %>" class="btn hero-btn"><%= profile.role === 'ADMIN' ? 'Manage training' : 'Explore my training' %> <span aria-hidden="true">↗</span></a>
  </div>
  <div class="hero-art" aria-hidden="true">
    <%# A real turning globe (public/js/hero-globe.js): one loop around the orbit, a landing in Tashkent,
        then a fleet leaving Uzbekistan for the world. The far half of the orbit and anything on the far
        side of the globe are hidden behind it. %>
    <svg viewBox="0 0 400 270" fill="none" focusable="false" data-globe>
      <defs>
        <mask id="workspace-behind-globe" maskUnits="userSpaceOnUse" x="-60" y="-60" width="520" height="390">
          <rect x="-60" y="-60" width="520" height="390" fill="white"/>
          <circle cx="204" cy="133" r="102" fill="black"/>
        </mask>
        <clipPath id="workspace-globe-clip"><circle cx="204" cy="133" r="101"/></clipPath>
        <path id="workspace-aircraft" d="M21 0C21-1 19-2 16-2L3-3-9-17-15-17-8-3-19-2-24-7-27-7-24 0-27 7-24 7-19 2-8 3-15 17-9 17 3 3 16 2C19 2 21 1 21 0Z"/>
        <radialGradient id="workspace-sphere" cx="34%" cy="28%" r="78%">
          <stop stop-color="#5a4f93"/>
          <stop offset=".55" stop-color="#2c2659"/>
          <stop offset="1" stop-color="#15122e"/>
        </radialGradient>
        <radialGradient id="workspace-shade" cx="70%" cy="72%" r="65%">
          <stop offset=".35" stop-color="#0b0a1c" stop-opacity="0"/>
          <stop offset="1" stop-color="#0b0a1c" stop-opacity=".6"/>
        </radialGradient>
        <linearGradient id="workspace-orbit-front" x1="49" y1="0" x2="359" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#dca878" stop-opacity=".35"/>
          <stop offset=".5" stop-color="#f6d9a8"/>
          <stop offset="1" stop-color="#dca878" stop-opacity=".35"/>
        </linearGradient>
        <filter id="workspace-glow" x="-20%" y="-60%" width="140%" height="220%"><feGaussianBlur stdDeviation="2.4"/></filter>
      </defs>
      <circle class="planet-halo" cx="204" cy="133" r="122"/>
      <g transform="rotate(-18 204 133)"><path class="orbit-back" mask="url(#workspace-behind-globe)" d="M49 133A155 48 0 0 1 359 133"/></g>
      <g mask="url(#workspace-behind-globe)"><g class="globe-plane" data-plane-back style="visibility:hidden"><use href="#workspace-aircraft"/></g></g>
      <circle class="planet-surface" cx="204" cy="133" r="101" fill="url(#workspace-sphere)"/>
      <g clip-path="url(#workspace-globe-clip)">
        <path class="globe-grid" data-graticule/>
        <path class="globe-land" data-land/>
        <path class="globe-uz" data-uz/>
        <g data-trails></g>
        <circle cx="204" cy="133" r="101" fill="url(#workspace-shade)"/>
      </g>
      <circle class="planet-rim" cx="204" cy="133" r="101"/>
      <g transform="rotate(-18 204 133)">
        <path class="orbit-front-glow" d="M359 133A155 48 0 0 1 49 133" filter="url(#workspace-glow)"/>
        <path class="orbit-front" d="M359 133A155 48 0 0 1 49 133"/>
      </g>
      <g class="globe-uz-mark" data-uz-mark style="visibility:hidden">
        <circle class="globe-uz-pulse" r="7"/>
        <circle class="globe-uz-dot" r="2.4"/>
        <text class="globe-uz-label" x="7" y="-7">Uzbekistan</text>
      </g>
      <g data-fleet></g>
      <g class="globe-plane" data-plane-front style="visibility:hidden"><use href="#workspace-aircraft"/></g>
    </svg>
    <div class="hero-coordinate">KNOWLEDGE → CONFIDENCE → EXCELLENCE</div>
  </div>
</section>
<script src="<%= asset('/static/js/hero-globe.js') %>" defer></script>
