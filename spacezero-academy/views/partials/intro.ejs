<link rel="stylesheet" href="<%= asset('/static/css/intro.css') %>" />
<div class="workspace-intro workspace-intro--premium" id="workspace-intro" hidden role="dialog" aria-modal="true" aria-label="Welcome to Space Zero Workspace">
  <div class="intro-frame" aria-hidden="true"><span>SPACE ZERO / WORKSPACE</span><span>THE ART OF EXCELLENCE</span></div>
  <svg class="intro-orbits" viewBox="0 0 1000 800" fill="none" aria-hidden="true"><ellipse cx="500" cy="400" rx="440" ry="210" transform="rotate(-32 500 400)"/><ellipse cx="500" cy="400" rx="440" ry="210" transform="rotate(32 500 400)"/><circle cx="500" cy="400" r="310"/><circle cx="182" cy="218" r="3" class="intro-star"/><circle cx="821" cy="578" r="4" class="intro-star"/></svg>
  <div class="workspace-intro__halo" aria-hidden="true"></div>
  <div class="workspace-intro__center">
    <p class="workspace-intro__eyebrow"><span></span> WELCOME ABOARD</p>
    <%- include('brand-mark', { brandVariant: 'dark' }) %>
    <p class="intro-tagline">Your next level begins here.</p>
    <div class="workspace-intro__loading">
      <div class="workspace-intro__labels"><span>PREPARING YOUR WORKSPACE</span><span data-intro-percent aria-hidden="true">0%</span></div>
      <div class="workspace-intro__track" role="progressbar" aria-label="Opening workspace" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="workspace-intro__fill"></div></div>
    </div>
    <p class="workspace-intro__motto">KNOWLEDGE · CONFIDENCE · EXCELLENCE</p>
  </div>
  <uzleeder-crafted class="workspace-intro__credit" theme="dark" size="sm"></uzleeder-crafted>
</div>
<script src="<%= asset('/static/js/intro.js') %>"></script>
<script src="<%= asset('/static/js/uzleeder-crafted.js') %>" defer></script>
