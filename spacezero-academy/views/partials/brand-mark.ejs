<%
// Single source of truth for the SpaceZero logo: the globe-and-plane mark in a navy
// badge (partials/space-ai-mark, the same mark as the logo artwork) plus the
// "SPACEZERO / — WORKSPACE —" wordmark, whose color adapts to the surface it sits on. Used in the sidebar, every auth
// page, and the certificate — so the brand mark never drifts between screens.
const variant = typeof brandVariant !== 'undefined' ? brandVariant : 'light';
const size = typeof brandSize !== 'undefined' ? brandSize : '';
%>
<div class="brand-mark brand-mark--<%= variant %><%= size ? ' brand-mark--' + size : '' %>">
  <div class="brand-mark-box">
    <%- include('space-ai-mark') %>
  </div>
  <div class="brand-mark-text">
    <div class="brand-mark-word">SPACEZERO</div>
    <div class="brand-mark-sub"><span class="brand-mark-dash" aria-hidden="true"></span>WORKSPACE<span class="brand-mark-dash" aria-hidden="true"></span></div>
  </div>
</div>
