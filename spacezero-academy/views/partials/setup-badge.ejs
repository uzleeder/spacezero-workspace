<%# Readiness is always shown as percentage + text, never colour alone. %>
<% if (setup.notStarted) { %>
<span class="badge" title="This employee has not been activated yet"><%= '○' %> Setup Not Started</span>
<% } else { %>
<span class="badge <%= setup.fullySetUp ? 'badge-success' : setup.hasIssue ? 'badge-danger' : 'badge-warning' %>" title="<%= setup.completed %> of <%= setup.required %> required items completed"><%= setup.fullySetUp ? '●' : setup.hasIssue ? '▲' : '○' %> <%= setup.percent %>% — <%= setup.hasIssue && !setup.fullySetUp ? 'Setup Issue' : setup.label %></span>
<% } %>