<%# A new Travel Agent's path in one line (lib/newAgentBoard.js stageText): Before day 1 · Month 1 · Ready for solo live
    calls (Pre-start · Month 1 · Ramp · Live while the ramp is on), with where they are now said in words, never by
    colour alone. %>
<% const at = stage.at; %>
<ol class="stage-line" aria-label="New agent path" style="grid-template-columns:repeat(<%= stage.path.length %>,minmax(0,1fr))">
  <% stage.path.forEach(function (p, i) { %>
    <li class="stage-line__step<%= i < at ? ' is-done' : i === at ? ' is-now' : '' %>"<%- i === at ? ' aria-current="step"' : '' %>>
      <span class="stage-line__name"><%= p.name %><% if (i < at) { %><span class="visually-hidden"> (done)</span><% } %></span>
      <% if (i === at) { %><span class="stage-line__detail"><%= stage.stepDetail %></span><% } %>
    </li>
  <% }); %>
</ol>
