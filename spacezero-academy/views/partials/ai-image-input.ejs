<div class="ai-attachment">
  <label class="ai-attach-button">+ Attach image<input type="file" name="image" accept="image/png,image/jpeg,image/webp" data-ai-image aria-label="Attach image" /></label>
  <span class="ai-hint">PNG, JPEG or WebP · Up to 5 MB</span>
  <div class="ai-image-preview" data-ai-preview hidden><img alt="Image ready to send" /><span data-ai-filename></span><button type="button" data-ai-remove-image>Remove image</button></div>
  <p class="ai-hint" data-ai-image-note hidden>This image will be sent to Space AI when you send your message.</p>
  <p class="ai-error" data-ai-image-error role="alert"></p>
</div>
