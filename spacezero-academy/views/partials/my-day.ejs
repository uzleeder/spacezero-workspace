<%# A new Travel Agent's "My day" on My Training (lib/newAgentBoard.js myDayFor): where they are on the path, then ONE
    ordered checklist - anything still open from before first, then today's - with how much is done, who they see
    today, and in the ramp their numbers against the targets. "All my training" is the only other way out. A "Quick
    check" asks whether a sign-off, demo or 1:1 really happened; the answer goes to the admins. Then what it takes to be
    ready for solo live calls, and "My month": the weeks folded like a course outline, this week open. %>
<%
const d = day;
const longDate = function (key) { return new Date(key + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }); };
const dm = function (x) { return new Date(x).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); };
%>
<section class="card mt-24 myday" id="my-day" data-my-day>
  <div class="card-body">
    <% if (d.stage) { %><%- include('stage-line', { stage: d.stage }) %><% } %>

    <% if (d.stage && d.stage.stage === 'PRE_START') { %>
      <h2 class="myday__title">You start <%= longDate(d.startKey) %></h2>
      <p class="myday__meta"><%= d.supervisorName ? 'Your supervisor is ' + d.supervisorName + '.' : 'Your supervisor will meet you on your first day.' %> Everything you need will be ready.</p>
    <% } else if (d.stage && d.stage.stage === 'LIVE') { %>
      <h2 class="myday__title">✓ Approved for solo live calls</h2>
      <p class="myday__meta">On <%= dm(d.approvedAt) %>. Well done.</p>
    <% } else { %>
      <div class="myday__head">
        <h2 class="myday__title"><%= d.dayOff && !d.rows.length ? 'Day off today' : 'Today' %></h2>
        <% if (d.total) { %><p class="myday__meta"><strong><%= d.done %> of <%= d.total %></strong> done</p><% } %>
      </div>
      <% if (d.total) { %>
        <div class="read-line" role="progressbar" aria-label="Today done" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= d.percent %>"><div class="read-line__track"><div class="read-line__fill" style="width:<%= d.percent %>%"></div></div><span class="read-line__percent"><%= d.percent %>%</span></div>
        <ol class="myday__list">
          <% d.rows.forEach(function (r) { %>
            <li class="myday__row<%= r.done ? ' is-done' : r.late ? ' is-late' : '' %>" data-my-day-row="<%= r.id %>">
              <span class="myday__mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><% if (r.done) { %><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><% } else { %><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><% } %></svg></span>
              <span class="myday__main">
                <% if (r.href) { %><a class="myday__name" href="<%= r.href %>"><span class="visually-hidden"><%= r.late ? 'Late: ' : 'To do: ' %></span><%= r.title %></a><% } else { %><span class="myday__name"><span class="visually-hidden"><%= r.done ? 'Done: ' : r.late ? 'Late: ' : 'To do: ' %></span><%= r.title %></span><% } %>
                <% if (r.meta) { %><span class="myday__meta"><%= r.meta %></span><% } %>
              </span>
            </li>
          <% }); %>
        </ol>
      <% } else { %>
        <p class="myday__meta"><%= d.dayOff ? 'Nothing is waiting. Enjoy your day off.' : '✓ Nothing is waiting today.' %></p>
      <% } %>
      <% if (d.withYou) { %><p class="myday__meta mt-8"><%= d.withYou %>.</p><% } %>
      <% if (d.checks && d.checks.length) { %>
        <div class="myday__checks" aria-labelledby="myday-checks-title">
          <h3 id="myday-checks-title" class="myday__label">Quick check</h3>
          <p class="myday__meta">Your answer goes to the admins, not to your supervisor.</p>
          <% d.checks.forEach(function (c) { %>
            <form method="post" action="/training/my-day/answer/<%= c.id %>" class="myday__check" data-once data-my-day-check="<%= c.id %>">
              <p class="myday__q"><%= c.question %></p>
              <div class="myday__answers">
                <% Object.keys(d.answers).forEach(function (k) { %><button type="submit" name="answer" value="<%= k %>" class="btn btn-secondary btn-sm"><%= d.answers[k] %></button><% }); %>
              </div>
            </form>
          <% }); %>
        </div>
      <% } %>
      <% if (d.readiness) { const r = d.readiness; %>
        <div class="myday__ready" data-my-day-ready>
          <h3 class="myday__label">Ready for solo live calls<%= d.checkKey ? ': what it takes by ' + longDate(d.checkKey) : '' %></h3>
          <ul class="myday__readylist">
            <% r.checks.forEach(function (c) { %><li class="<%= c.ok ? 'is-done' : '' %>"><span class="myday__mark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><% if (c.ok) { %><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><% } else { %><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 2.5"/><% } %></svg></span><span><span class="visually-hidden"><%= c.ok ? 'Met: ' : 'Not yet: ' %></span><%= c.label %></span><span class="myday__meta"><%= c.detail %></span></li><% }); %>
          </ul>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
<% if (d.month && d.month.length && (!d.stage || d.stage.stage !== 'LIVE')) { %>
<section class="mt-24 mymonth" aria-labelledby="mymonth-title" data-my-month>
  <h2 id="mymonth-title" class="myday__title">My month</h2>
  <% d.month.forEach(function (w) { %>
    <details class="naw<%= w.isNow ? ' is-now' : '' %>" data-my-week="<%= w.number %>"<%= w.isNow ? ' open' : '' %>>
      <summary class="naw__head">
        <span class="naw__badge naw__badge--<%= w.isDone ? 'done' : w.isNow ? 'now' : 'ahead' %>" aria-hidden="true"><% if (w.isDone) { %><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><% } %></span>
        <span class="naw__text"><span class="na-strong na-trunc"><%= w.name %><% if (w.isNow) { %> <span class="naw__pill">This week</span><% } %></span><span class="na-meta na-trunc"><%= w.range ? w.range + ' · ' : '' %><%= w.note %></span></span>
        <span class="naw__bar" aria-hidden="true"><span style="width:<%= w.percent %>%"></span></span>
        <span class="naw__count"><%= w.done %> of <%= w.total %></span>
        <svg class="na-chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <% w.days.forEach(function (day) { %>
        <div class="na-day<%= day.isToday ? ' is-today' : '' %>">
          <div class="na-day__head"><span class="na-label"><%= day.label %></span></div>
          <% day.items.forEach(function (it) { %>
            <div class="na-task na-task--<%= it.state %>">
              <span class="na-task__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><% if (it.state === 'done') { %><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><% } else if (it.state === 'late') { %><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3.5M8 10.8v.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><% } else { %><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"<%- it.state === 'today' ? '' : ' stroke-dasharray="2.5 2.5"' %>/><% } %></svg></span>
              <span class="na-task__main"><span class="na-task__title"><%= it.title %></span><% if (it.kind) { %><span class="na-task__kind"><%= it.kind %></span><% } %></span>
              <span class="na-task__end"><span class="<%= it.state === 'late' ? 'na-late' : 'na-meta' %>"><%= it.when %></span></span>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </details>
  <% }); %>
</section>
<% } %>
<p class="mt-16"><a class="link-gold text-sm" href="/training?all=1" data-all-training>All my training</a></p>
