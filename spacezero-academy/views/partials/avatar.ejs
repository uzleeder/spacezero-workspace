<%
// Shared avatar renderer: an uploaded photo always wins; everyone without one gets the SpaceZero
// default picture (public/images/default-avatar.webp, the SPACE artwork). If an uploaded photo's file
// is gone, the site script (public/js/app.js) swaps in the same default picture.
// profile: { fullName, photoUrl }. size: 'sm' | 'md' | 'lg' (default 'sm').
const p = profile;
const sizeClass = typeof size !== 'undefined' ? size : 'sm';
const defaultSrc = asset('/static/images/default-avatar.webp');
%>
<% if (p.photoUrl) { %>
  <img src="<%= p.photoUrl %>" alt="<%= p.fullName %>" class="avatar avatar-<%= sizeClass %>" style="object-fit:cover" data-fallback-src="<%= defaultSrc %>" />
<% } else { %>
  <img src="<%= defaultSrc %>" alt="<%= p.fullName %>" class="avatar avatar-<%= sizeClass %> avatar-default" width="256" height="256" loading="lazy" />
<% } %>
