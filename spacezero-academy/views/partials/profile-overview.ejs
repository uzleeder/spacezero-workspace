<%
const ATTEMPT_STATUS_LABEL = {
  NOT_STARTED: 'Not started', IN_PROGRESS: 'In progress', COMPLETED: 'Completed',
  FAILED: 'Failed', RETAKE_REQUIRED: 'Retake required',
};
const ATTEMPT_STATUS_TONE = {
  NOT_STARTED: '', IN_PROGRESS: 'badge-warning', COMPLETED: 'badge-success',
  FAILED: 'badge-danger', RETAKE_REQUIRED: 'badge-danger',
};
const p = data.profile;
%>
<div class="card" style="padding:24px">
  <div class="row-between" style="align-items:flex-start;flex-wrap:wrap;gap:16px">
    <div style="display:flex;align-items:center;gap:16px">
      <% if (typeof isOwnProfile !== 'undefined' && isOwnProfile) { %>
        <form method="post" action="/profile/photo" enctype="multipart/form-data" class="avatar-upload" title="Change photo">
          <%- include('avatar', { profile: p, size: 'lg' }) %>
          <div class="avatar-upload-overlay">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5V19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2.5M17 8l-5-5-5 5M12 3v13"/></svg>
          </div>
          <input type="file" name="photo" accept="image/png,image/jpeg,image/webp" data-auto-submit aria-label="Change profile photo" />
        </form>
      <% } else { %>
        <%- include('avatar', { profile: p, size: 'lg' }) %>
      <% } %>
      <div>
        <h2 style="font-size:18px;font-weight:600;color:var(--navy-950)"><%= p.fullName %></h2>
        <p class="text-sm text-muted"><%= roleLabel(p.role) %> · @<%= p.username %></p>
        <p class="text-sm text-muted"><%= p.email %></p>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px">
      <span class="badge badge-navy"><%= p.teamMemberships[0] ? p.teamMemberships[0].team.name : 'No team' %></span>
      <% if (p.supervisedBy[0]) { %><span class="badge badge-gold">Supervisor: <%= p.supervisedBy[0].supervisor.fullName %></span><% } %>
      <% if (data.tenureBand) { %><span class="badge"><%= data.tenureBand.label %></span><% } %>
    </div>
  </div>
  <div class="grid grid-4 mt-24 divider-top" style="padding-top:20px">
    <div><p class="text-sm text-muted">Employment start date</p><p style="font-weight:500;color:var(--navy-950)"><%= p.employmentStartDate.toLocaleDateString('en-US') %></p></div>
    <div><p class="text-sm text-muted">Tenure</p><p style="font-weight:500;color:var(--navy-950)"><%= data.tenureMonths %> months</p></div>
    <div><p class="text-sm text-muted">Last activity</p><p style="font-weight:500;color:var(--navy-950)"><%= p.lastActivityAt ? p.lastActivityAt.toLocaleString('en-US') : '—' %></p></div>
    <div><p class="text-sm text-muted">Status</p><p style="font-weight:500;color:var(--navy-950)"><%= p.status %></p></div>
  </div>
</div>

<%
  // A quick-glance summary — objective facts only, never a blended "performance score". Each
  // figure comes straight from the same computation the rest of the app already uses (setup
  // badge, training summary, Skill Graph, Standards ack, the shared readiness decision), so it
  // can never disagree with the sections below it.
  const skillAvg = data.hasSkillGraph && data.skills.length ? Math.round(data.skills.reduce((s, x) => s + x.currentScore, 0) / data.skills.length) : null;
%>
<div class="grid grid-4 mt-24">
  <div class="card stat-card"><p class="label">Setup</p><p class="value"><%= data.setup.notStarted ? '—' : data.setup.percent + '%' %></p></div>
  <div class="card stat-card"><p class="label">Training</p><p class="value"><%= data.summary.completed %> / <%= data.summary.assigned %></p></div>
  <% if (skillAvg !== null) { %><div class="card stat-card"><p class="label">Skills</p><p class="value"><%= skillAvg %>%</p></div><% } %>
  <% if (data.standardsAck && data.standardsAck.required > 0) { %><div class="card stat-card"><p class="label">Standards</p><p class="value"><%= data.standardsAck.pending %> Pending</p></div><% } %>
  <% if (data.readiness) { %><a href="<%= p.status === 'INVITED' ? '#' : (data.readiness.key === 'READY' ? '#' : '/employees/' + p.id + '/setup') %>" class="card stat-card card-link"><p class="label">Status</p><p class="value" style="font-size:18px"><span class="badge <%= data.readiness.tone %>"><%= data.readiness.label %></span></p></a><% } %>
</div>

<div class="card mt-24">
  <div class="card-header row-between"><h2>Setup &amp; availability</h2><a href="/employees/<%= p.id %>/setup" class="link-gold text-sm">Open setup</a></div>
  <div class="card-body">
    <div class="grid grid-4">
      <div><p class="text-sm text-muted">Setup</p><div style="margin-top:4px"><%- include('setup-badge', { setup: data.setup }) %></div></div>
      <div><p class="text-sm text-muted">Local phone</p><p style="font-weight:500;color:var(--navy-950)"><%= p.localPhone || 'Not set up' %></p></div>
      <div><p class="text-sm text-muted">Current living address</p><p style="font-weight:500;color:var(--navy-950)"><%= data.hasAddress ? 'Address ✓' : 'Address missing' %></p></div>
      <div><p class="text-sm text-muted">Vacation / leave</p>
        <% if (data.upcomingLeave.length === 0) { %><p style="font-weight:500;color:var(--navy-950)">None planned</p>
        <% } else { var l = data.upcomingLeave[0]; %><p style="font-weight:500;color:var(--navy-950)"><%= l.status === 'PENDING' ? 'Pending' : 'Approved' %> · <%= l.startDate.toISOString().slice(0, 10) %> → <%= l.endDate.toISOString().slice(0, 10) %></p><% } %>
      </div>
    </div>
  </div>
</div>

<% if (data.standardsAck && data.standardsAck.required > 0) { %>
<div class="card mt-24">
  <div class="card-header row-between">
    <h2>Company Standards</h2>
    <a href="/standards" class="link-gold text-sm">Review</a>
  </div>
  <div class="card-body">
    <% if (data.standardsAck.pending === 0) { %>
      <p style="font-weight:500;color:var(--navy-950)">✓ All required standards acknowledged</p>
    <% } else { %>
      <p style="font-weight:500;color:var(--navy-950)"><%= data.standardsAck.pending %> standard<%= data.standardsAck.pending === 1 ? '' : 's' %> require<%= data.standardsAck.pending === 1 ? 's' : '' %> acknowledgement</p>
    <% } %>
  </div>
</div>
<% } %>

<% if (p.role === 'TRAVEL_AGENT') { %>
<div class="card mt-24">
  <div class="card-header"><h2>Contact</h2><p>Call or open a conversation directly.</p></div>
  <div class="card-body">
    <% if (typeof isOwnProfile !== 'undefined' && isOwnProfile) { %>
      <details class="contact-editor" <%= !p.phonePrimary && !p.phoneSecondary && !p.whatsappNumber && !p.telegramContact && !p.phoneUzbekistan ? 'open' : '' %>>
      <summary class="link-gold">Edit contact info</summary>
      <form method="post" action="/profile/contact">
        <div class="grid grid-2">
          <div class="field">
            <label for="phonePrimary">Phone</label>
            <input id="phonePrimary" name="phonePrimary" value="<%= p.phonePrimary || '' %>" placeholder="+1 813 697 5394" />
          </div>
          <div class="field">
            <label for="phoneSecondary">Phone (secondary)</label>
            <input id="phoneSecondary" name="phoneSecondary" value="<%= p.phoneSecondary || '' %>" placeholder="+61 485 861 680" />
          </div>
          <div class="field">
            <label for="whatsappNumber">WhatsApp</label>
            <input id="whatsappNumber" name="whatsappNumber" value="<%= p.whatsappNumber || '' %>" placeholder="+44 7441 921335" />
          </div>
          <div class="field">
            <label for="telegramContact">Telegram</label>
            <input id="telegramContact" name="telegramContact" value="<%= p.telegramContact || '' %>" placeholder="@username or +44 7441 921335" />
          </div>
          <div class="field">
            <label for="phoneUzbekistan">UZ number</label>
            <input id="phoneUzbekistan" name="phoneUzbekistan" value="<%= p.phoneUzbekistan || '' %>" placeholder="+998 90 123 45 67" />
          </div>
        </div>
        <button type="submit" class="btn btn-gold mt-16">Save contact info</button>
      </form>
      </details>
    <% } %>
    <% if (!p.phonePrimary && !p.phoneSecondary && !p.whatsappNumber && !p.telegramContact && !p.phoneUzbekistan) { %>
      <%- include('empty-state', { title: 'No contact info added yet' }) %>
    <% } else {
      const waHref = p.whatsappNumber ? 'https://wa.me/' + p.whatsappNumber.replace(/[^0-9]/g, '') : null;
      const tgHandle = p.telegramContact ? p.telegramContact.trim().replace(/^https?:\/\/(?:www\.)?t\.me\//i, '').replace(/^@/, '').replace(/\/$/, '') : null;
      const tgHref = tgHandle ? (/^[0-9+][0-9+ ()-]{4,}$/.test(tgHandle) ? 'https://t.me/+' + tgHandle.replace(/[^0-9]/g, '') : 'https://t.me/' + tgHandle) : null;
    %>
      <ul class="divide-list">
        <% if (p.phonePrimary) { %><li><a class="row-between contact-row" href="tel:<%= p.phonePrimary.replace(/\s+/g,'') %>"><span style="display:flex;align-items:center;gap:10px"><%- include('icon', { name: 'calls' }) %> Phone</span><span style="font-weight:500;color:var(--navy-950)"><%= p.phonePrimary %></span></a></li><% } %>
        <% if (p.phoneSecondary) { %><li><a class="row-between contact-row" href="tel:<%= p.phoneSecondary.replace(/\s+/g,'') %>"><span style="display:flex;align-items:center;gap:10px"><%- include('icon', { name: 'calls' }) %> Phone</span><span style="font-weight:500;color:var(--navy-950)"><%= p.phoneSecondary %></span></a></li><% } %>
        <% if (p.phoneUzbekistan) { %><li><a class="row-between contact-row" href="tel:<%= p.phoneUzbekistan.replace(/\s+/g,'') %>"><span style="display:flex;align-items:center;gap:10px"><%- include('icon', { name: 'calls' }) %> UZ number</span><span style="font-weight:500;color:var(--navy-950)"><%= p.phoneUzbekistan %></span></a></li><% } %>
        <% if (p.whatsappNumber) { %><li><a class="row-between contact-row" href="<%= waHref %>" target="_blank" rel="noopener"><span style="display:flex;align-items:center;gap:10px"><%- include('icon', { name: 'calls' }) %> WhatsApp</span><span style="font-weight:500;color:var(--navy-950)"><%= p.whatsappNumber %></span></a></li><% } %>
        <% if (p.telegramContact) { %><li><a class="row-between contact-row" href="<%= tgHref %>" target="_blank" rel="noopener"><span style="display:flex;align-items:center;gap:10px"><%- include('icon', { name: 'telegram' }) %> Telegram</span><span style="font-weight:500;color:var(--navy-950)"><%= p.telegramContact %></span></a></li><% } %>
      </ul>
    <% } %>
  </div>
</div>
<% } %>

<div class="grid grid-2 mt-24">
  <div class="card stat-card"><p class="label">Assigned</p><p class="value"><%= data.summary.assigned %></p></div>
  <div class="card stat-card"><p class="label">In progress</p><p class="value"><%= data.summary.inProgress %></p></div>
  <div class="card stat-card"><p class="label">Completed</p><p class="value"><%= data.summary.completed %></p></div>
  <div class="card stat-card"><p class="label">Retake required</p><p class="value"><%= data.summary.retakeRequired %></p></div>
</div>

<% if (data.hasSkillGraph) { %>
<div class="card mt-24">
  <div class="card-header"><h2>Skill Graph</h2><p>Current level and confidence for each skill.</p></div>
  <div class="card-body">
    <% if (data.skills.length === 0) { %>
      <%- include('empty-state', { title: 'No skills defined for this role yet' }) %>
    <% } else { %>
      <div class="grid grid-2">
        <% data.skills.forEach(function (s) { %>
          <div>
            <div class="row-between" style="margin-bottom:4px">
              <span style="font-weight:500;color:var(--navy-950);font-size:14px"><%= s.skill.name %></span>
              <span class="text-sm text-muted"><%= Math.round(s.currentScore) %>%</span>
            </div>
            <div class="progress-track"><div class="progress-fill" style="width:<%= s.currentScore %>%"></div></div>
            <p class="text-sm text-muted" style="margin-top:4px">Evidence: <%= s.evidenceCount %> · Confidence: <%= Math.round(s.confidence) %>%</p>
            <% if (typeof canRecordEvidence !== 'undefined' && canRecordEvidence) { %>
              <form method="post" action="/skills/<%= s.id %>/evidence" style="display:flex;gap:6px;margin-top:8px;align-items:center">
                <input name="notes" minlength="10" maxlength="5000" placeholder="Evidence or coaching observation" aria-label="Evidence notes" required />
                <button type="submit" class="btn btn-secondary btn-sm">Record</button>
              </form>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
<% } %>

<% if (data.certificates && data.certificates.length > 0) { %>
<div class="card mt-24">
  <div class="card-header"><h2>Certificates &amp; Achievements</h2></div>
  <div class="card-body">
    <ul class="divide-list">
      <% data.certificates.forEach(function (c) { %>
        <li class="row-between">
          <a href="/certificates/<%= c.id %>" style="flex:1">
            <p style="font-weight:500;color:var(--navy-950)"><%= c.title %></p>
            <p class="text-sm text-muted"><%= c.description %></p>
          </a>
          <a href="/certificates/<%= c.id %>" class="badge badge-gold">View · <%= c.issuedAt.toLocaleDateString('en-US') %></a>
        </li>
      <% }); %>
    </ul>
  </div>
</div>
<% } %>

<%
  // Call Reviews is its own feature/route, kept fully intact (upload form and all) — this card is
  // just a contextual doorway to it now that the top-level "Call reviews" tab is gone.
  var canOpenCallReviews = profile.role === 'ADMIN' || profile.role === 'SUPERVISOR';
%>
<% if ((data.callReviews && data.callReviews.length > 0) || canOpenCallReviews) { %>
<div class="card mt-24">
  <div class="card-header row-between">
    <h2>Call Reviews</h2>
    <% if (profile.role === 'ADMIN') { %><a href="/admin/call-reviews" class="link-gold text-sm">Open Call Reviews</a>
    <% } else if (profile.role === 'SUPERVISOR') { %><a href="/call-reviews" class="link-gold text-sm">Open Call Reviews</a>
    <% } %>
  </div>
  <div class="card-body">
    <% if (data.callReviews && data.callReviews.length > 0) { %>
      <ul class="divide-list">
        <% data.callReviews.forEach(function (cr) { %>
          <li>
            <p style="font-weight:500;color:var(--navy-950)"><%= cr.supervisor.fullName %> · <%= cr.createdAt.toLocaleDateString('en-US') %></p>
            <% if (cr.feedback) { %><p class="text-sm text-muted" style="margin-top:4px"><%= cr.feedback %></p><% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <%- include('empty-state', { title: 'No call reviews yet' }) %>
    <% } %>
  </div>
</div>
<% } %>

<% if (typeof canViewTrainingHistory === 'undefined' || canViewTrainingHistory) { %>
<div class="card mt-24">
  <div class="card-header"><h2>Training History</h2></div>
  <div class="card-body">
    <% if (data.trainingList.length === 0) { %>
      <%- include('empty-state', { title: 'No training assigned yet', description: 'Assigned trainings will appear here.' }) %>
    <% } else { %>
      <ul class="divide-list">
        <% data.trainingList.forEach(function (r) { %>
          <li class="row-between">
            <div>
              <p style="font-weight:500;color:var(--navy-950)"><%= r.assignment.course.title %></p>
              <p class="text-sm text-muted"><%= r.assignment.course.modules.length %> modules</p>
            </div>
            <span class="badge <%= ATTEMPT_STATUS_TONE[r.status] %>"><%= ATTEMPT_STATUS_LABEL[r.status] %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>
<% } %>
