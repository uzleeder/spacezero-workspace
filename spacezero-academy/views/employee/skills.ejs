<%- include('../partials/employee-frame') %>
<div class="card mt-24" style="margin-bottom:40px">
  <div class="card-header"><h2>Skill Graph</h2><p>Built from real assessment, practice and call evidence.</p></div>
  <div class="card-body">
    <% if (skills.length === 0) { %>
      <%- include('../partials/empty-state', { title: 'No skills tracked yet' }) %>
    <% } else { %>
      <% skills.forEach(function (s) { %>
        <div style="margin-top:14px">
          <div class="row-between" style="margin-bottom:4px">
            <span style="font-weight:500;color:var(--navy-950);font-size:14px"><%= s.skill.name %></span>
            <span class="text-sm text-muted"><%= Math.round(s.currentScore) %>%<% if (s.evidenceCount > 0) { %> — <%= competencyLabel(Math.round(s.currentScore)) %><% } %></span>
          </div>
          <div class="progress-track"><div class="progress-fill navy" style="width:<%= Math.round(s.currentScore) %>%"></div></div>
          <% if (!isSelf && ['ADMIN', 'SUPERVISOR'].includes(profile.role) && s.evidenceCount > 0 && s.currentScore < 70) { %>
            <p class="text-sm" style="margin-top:4px"><span class="badge badge-danger">Priority improvement</span> <a class="link-gold" href="/assignments?personId=<%= employee.id %>">Assign practice</a></p>
          <% } %>
          <p class="text-sm text-muted" style="margin-top:4px">Confidence <%= Math.round(s.confidence) %>% · <%= s.evidenceCount %> evidence points · Last assessed: <%= s.lastAssessedAt ? s.lastAssessedAt.toLocaleDateString('en-US') : 'never' %></p>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
