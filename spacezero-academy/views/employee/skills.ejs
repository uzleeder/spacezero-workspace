<%- include('../partials/employee-frame') %>
<div class="card mt-24" style="margin-bottom:40px">
  <div class="card-header"><h2>Skill Graph</h2><p>Built from real assessment, practice and call evidence.</p></div>
  <div class="card-body">
    <% if (skills.length === 0) { %>
      <%- include('../partials/empty-state', { title: 'No skills tracked yet' }) %>
    <% } else { %>
      <div class="skill-grid">
      <% skills.forEach(function (s) { var score = Math.round(s.currentScore); var lvl = s.evidenceCount === 0 ? 'none' : score >= 70 ? 'strong' : score >= 40 ? 'mid' : 'low'; %>
        <div class="skill-tile skill-tile--<%= lvl %>">
          <div class="skill-tile__top"><span class="skill-tile__name"><%= s.skill.name %></span><span class="skill-tile__score"><%= score %>%</span></div>
          <div class="progress-track"><div class="progress-fill" style="width:<%= score %>%"></div></div>
          <div class="skill-tile__meta"><span><%= s.evidenceCount %> evidence points</span><span>Confidence <%= Math.round(s.confidence) %>%</span></div>
          <% if (s.evidenceCount > 0) { %><p class="skill-tile__when"><%= competencyLabel(score) %></p><% } %>
          <% if (!isSelf && ['ADMIN', 'SUPERVISOR'].includes(profile.role) && s.evidenceCount > 0 && s.currentScore < 70) { %>
            <p class="skill-tile__when"><span class="badge badge-danger">Priority improvement</span><% if (can('training.assign')) { %> <a class="link-gold" href="/assignments?personId=<%= employee.id %>">Assign practice</a><% } %></p>
          <% } %>
          <p class="skill-tile__when">Last assessed: <%= s.lastAssessedAt ? s.lastAssessedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'never' %></p>
        </div>
      <% }); %>
      </div>
    <% } %>
  </div>
</div>
