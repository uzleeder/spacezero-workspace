<%- include('../partials/employee-frame') %>

<% if (error) { %><div class="form-alert error mt-16"><%= error %></div><% } %>
<% if (saved && conflicts > 0) { %><div class="form-alert error mt-16"><%= conflicts %> item<%= conflicts === 1 ? '' : 's' %> could not be saved because <%= conflicts === 1 ? 'it was' : 'they were' %> changed elsewhere in the meantime — reopen this page and try again.</div><% } %>
<% if (saved && changed !== null) { %><div class="form-alert success mt-16">✓ Setup updated<%= changed ? ' — ' + changed + ' item' + (changed === 1 ? '' : 's') + ' changed' : '' %></div><% } %>

<div class="card mt-24">
  <div class="card-body">
    <div class="row-between">
      <div>
        <p class="text-sm text-muted">Employee Setup</p>
        <p style="font-size:28px;font-weight:600;color:var(--navy-950)"><%= setup.notStarted ? '—' : setup.percent + '%' %></p>
      </div>
      <%- include('../partials/setup-badge', { setup: setup }) %>
    </div>
    <div class="progress-track mt-16"><div class="progress-fill navy" style="width:<%= setup.percent %>%"></div></div>
    <p class="text-sm text-muted mt-16"><%= setup.completed %> of <%= setup.required %> required items completed<%= setup.awaitingVerification ? ', ' + setup.awaitingVerification + ' more confirmed and awaiting verification' : '' %>.
      <% if (setup.notStarted) { %>Setup starts once this account has been activated.<% } else if (isSelf && !manage) { %>Some items you can confirm yourself; the rest are verified by your supervisor or an administrator.<% } %></p>
  </div>
</div>

<% if (manage) { %>
  <%
    // The compact checklist handles the common case (a plain, non-company-controlled item that is
    // either not set up or completed) as a single checkbox. Anything else — company-controlled items
    // (WhatsApp/Telegram), calculated items, or a row already in an exception state (In Progress /
    // Issue / Not Required) — keeps its full row and its own individual edit, unchanged in spirit
    // from before, just grouped separately so the common path stays short and scannable.
    const bulkEligible = setup.rows.filter((row) => row.requirement.kind === 'MANUAL' && !row.requirement.companyControlled && (['NOT_SET_UP', 'COMPLETED'].includes(row.status) || (isAdmin && row.awaitingVerification)));
    const otherRows = setup.rows.filter((row) => !bulkEligible.includes(row));
  %>
  <% if (bulkEligible.length) { %>
  <div class="card mt-24">
    <div class="card-header row-between">
      <h2>Checklist</h2>
      <span class="text-sm text-muted" data-unsaved-count hidden></span>
    </div>
    <form method="post" action="/employees/<%= employee.id %>/setup/bulk" data-bulk-setup-form>
      <ul class="divide-list" style="padding:0 24px">
        <% bulkEligible.forEach(function (row) { const r = row.requirement; const done = row.status === 'COMPLETED'; %>
        <li style="padding:10px 0">
          <label class="checkbox-row" style="justify-content:space-between;width:100%;gap:12px">
            <span style="display:flex;align-items:center;gap:10px;min-width:0">
              <input type="checkbox" name="checked" value="<%= r.id %>" <%= done ? 'checked' : '' %> data-bulk-checkbox data-was="<%= done ? '1' : '0' %>" />
              <span style="min-width:0"><%= r.label %><% if (!r.required) { %> <span class="badge" style="margin-left:4px">Optional</span><% } %></span>
            </span>
            <% if (row.ownerLabel || row.dueAt) { %><span class="text-sm text-muted" style="white-space:nowrap"><%= row.ownerLabel ? 'Owner: ' + row.ownerLabel : '' %><%= row.ownerLabel && row.dueAt ? ' · ' : '' %><% if (row.dueAt) { %><span class="<%= row.overdue ? 'trend-declining' : '' %>">Due: <%= row.dueAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><%= row.overdue ? ' — overdue' : '' %></span><% } %></span><% } %>
          </label>
          <% if (row.awaitingVerification) { %><p class="text-sm text-muted" style="margin:4px 0 0 26px">Awaiting your verification — check this item and Save Changes to complete it.</p><% } %>
          <input type="hidden" name="ts_<%= r.id %>" value="<%= row.item ? row.item.updatedAt.toISOString() : '' %>" />
          <details style="margin-left:26px;margin-top:4px">
            <summary class="text-sm text-muted" style="cursor:pointer">•••<% if (row.item && row.item.note) { %> · has a note<% } %></summary>
            <div class="mt-8"><%- include('../partials/setup-item-editor', { employee: employee, r: r, row: row, isAdmin: isAdmin, STATUSES: STATUSES, STATUS_LABEL: STATUS_LABEL, formId: 'item-form-' + r.id }) %></div>
          </details>
        </li>
        <% }); %>
      </ul>
      <div class="card-body row-between" style="border-top:1px solid var(--border-subtle)">
        <span class="text-sm text-muted" data-unsaved-hint>No changes yet</span>
        <button type="submit" class="btn btn-gold" data-bulk-save>Save Changes</button>
      </div>
    </form>
    <%
      // Nested <form> elements are invalid HTML, so each "..." editor above binds to one of these
      // real, empty forms via form="item-form-<id>" instead of being a DOM descendant of the bulk
      // form — see the comment in partials/setup-item-editor.ejs.
    %>
    <% bulkEligible.forEach(function (row) { %><form id="item-form-<%= row.requirement.id %>" method="post" action="/employees/<%= employee.id %>/setup/<%= row.requirement.id %>" hidden></form><% }); %>
  </div>
  <% } %>

  <% if (otherRows.length) { %>
  <div class="card mt-24">
    <div class="card-header"><h2><%= bulkEligible.length ? 'Company-controlled & exceptions' : 'Checklist' %></h2><% if (bulkEligible.length) { %><p>Needs a company number, calculated automatically, or already has a special status.</p><% } %></div>
    <ul class="divide-list" style="padding:0 24px">
      <% otherRows.forEach(function (row) { %>
        <% const r = row.requirement; const done = row.status === 'COMPLETED'; %>
        <li>
          <div class="row-between" style="align-items:flex-start;gap:16px">
            <div style="flex:1;min-width:0">
              <p style="font-weight:500;color:var(--navy-950)">
                <span aria-hidden="true"><%= done ? '✓' : row.status === 'NOT_REQUIRED' ? '–' : '✗' %></span>
                <%= r.label %>
                <% if (!r.required) { %><span class="badge" style="margin-left:6px">Optional</span><% } %>
              </p>
              <p class="text-sm text-muted" style="margin-top:2px"><%= r.category || 'Other' %><% if (!row.derived) { %> · <%= VERIFICATION_LABEL[row.rule] %><% } %></p>
              <% if (r.description) { %><p class="text-sm text-muted" style="margin-top:2px"><%= r.description %></p><% } %>
              <% if (row.ownerLabel || row.dueAt) { %><p class="text-sm" style="margin-top:2px"><%= row.ownerLabel ? 'Owner: ' + row.ownerLabel : '' %><%= row.ownerLabel && row.dueAt ? ' · ' : '' %><% if (row.dueAt) { %><span class="<%= row.overdue ? 'trend-declining' : '' %>">Due: <%= row.dueAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><%= row.overdue ? ' — overdue' : '' %></span><% } %></p><% } %>
              <p class="text-sm text-muted" style="margin-top:2px">
                <% if (row.derived) { %>Calculated from real data<% if (r.kind === 'CREDENTIAL_VAULT') { %> — contents of the vault are never shown here<% } %>.<% } %>
                <% if (row.vault) { %> Saved <%= row.vault.saved %> of <%= row.vault.total %> required systems<%= row.vault.missing.length ? ' - still needed: ' + row.vault.missing.join(', ') : '' %>.<% } %>
                <% if (row.item && row.item.verifiedAt && done) { %> Verified by <%= row.item.verifiedBy ? row.item.verifiedBy.fullName : 'management' %> on <%= row.item.verifiedAt.toLocaleDateString('en-US') %>.<% } else if (done && row.item && row.item.employeeConfirmedAt) { %> Confirmed by the employee on <%= row.item.employeeConfirmedAt.toLocaleDateString('en-US') %>.<% } %>
                <% if (row.awaitingVerification) { %> Confirmed by the employee — awaiting verification by a supervisor or administrator.<% } %>
                <% if (row.item) { %> Last updated <%= row.item.updatedAt.toLocaleDateString('en-US') %>.<% } %>
                <% if (row.awaitingCompanyControl) { %> Waiting for company ownership/recovery confirmation.<% } %>
              </p>
              <% if (r.companyControlled && row.item && row.item.accountType === 'PERSONAL_WORK') { %><p class="text-sm" style="margin-top:2px">Personal number — used for work.</p>
              <% } else if (r.companyControlled && row.item && row.item.companyNumber) { %><p class="text-sm" style="margin-top:2px">Company number/account: <%= row.item.companyNumber %></p><% } %>
              <% if (row.item && row.item.note) { %><p class="text-sm" style="margin-top:2px">Note: <%= row.item.note %></p><% } %>
            </div>
            <span class="badge <%= done ? 'badge-success' : row.status === 'ISSUE' ? 'badge-danger' : row.status === 'NOT_REQUIRED' ? '' : 'badge-warning' %>"><%= STATUS_LABEL[row.status] %></span>
          </div>
          <% if (!row.derived || isAdmin) { %>
            <div class="mt-16"><%- include('../partials/setup-item-editor', { employee: employee, r: r, row: row, isAdmin: isAdmin, STATUSES: STATUSES, STATUS_LABEL: STATUS_LABEL }) %></div>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </div>
  <% } %>
<% } else { %>
  <%
    // The employee's own compact checklist: a plain I Have / I Don't Have choice, batched into one
    // Save — same idea as the manage checklist above, just with self-confirm semantics (see
    // POST /employees/:id/setup/self-bulk). Items this employee cannot touch themselves —
    // company-controlled (WhatsApp/Telegram), management-only, already management-verified, or
    // explicitly Not Required — stay in a small read-only/exception list below, unchanged.
    const canSelfBulk = isSelf && !setup.notStarted;
    // An Admin using "View as" sees this person's checklist exactly as they do, but nobody confirms on
    // someone else's behalf — so it is shown read-only, with a way to manage the Setup as an Admin.
    const viewOnly = Boolean(isSelf && typeof impersonation !== 'undefined' && impersonation);
    const selfBulkEligible = canSelfBulk ? setup.rows.filter((row) => row.requirement.kind === 'MANUAL' && !row.requirement.companyControlled && row.rule !== 'MANAGEMENT_ONLY' && row.status !== 'NOT_REQUIRED') : [];
    const otherSelfRows = canSelfBulk ? setup.rows.filter((row) => !selfBulkEligible.includes(row)) : setup.rows;
  %>
  <% if (viewOnly) { %>
  <div class="form-alert mt-16" role="status" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px">
    <span>You are viewing <strong><%= employee.fullName %></strong>'s Setup as <%= impersonation.adminName %>. Only <%= employee.fullName %> can confirm their own items here, so this checklist is read-only.</span>
    <form method="post" action="/end-impersonation"><input type="hidden" name="next" value="/employees/<%= employee.id %>/setup" /><button type="submit" class="btn btn-gold btn-sm">Return to admin and manage this Setup</button></form>
  </div>
  <% } %>
  <% if (selfBulkEligible.length) { %>
  <div class="card mt-24">
    <div class="card-header row-between">
      <div><h2>Checklist</h2><p>Tick what you have, then Save Changes. Missing something? Press “I haven't”, write a note and it goes to your administrator.</p></div>
      <span class="text-sm text-muted" data-unsaved-count hidden></span>
    </div>
    <form method="post" action="/employees/<%= employee.id %>/setup/self-bulk" data-bulk-setup-form>
      <input type="hidden" name="mode" value="checkbox" />
      <ul class="divide-list" style="padding:0 24px">
        <% selfBulkEligible.forEach(function (row) { const r = row.requirement; const haveChecked = row.status === 'COMPLETED' || row.status === 'IN_PROGRESS'; const flagged = row.status === 'ISSUE'; const verified = row.status === 'COMPLETED' && row.item && row.item.verifiedById; const selfCompleted = row.status === 'COMPLETED' && row.item && row.item.employeeConfirmedAt && !verified; %>
        <li style="padding:10px 0">
          <label class="checkbox-row" style="justify-content:space-between;width:100%;gap:12px">
            <span style="display:flex;align-items:center;gap:10px;min-width:0">
              <% if (verified) { %>
              <input type="checkbox" checked disabled aria-label="Verified by management" />
              <% } else { %>
              <input type="checkbox" name="checked" value="<%= r.id %>" <%= haveChecked ? 'checked' : '' %> <%= viewOnly ? 'disabled' : '' %> data-bulk-checkbox data-was="<%= haveChecked ? '1' : '0' %>" />
              <% } %>
              <span style="min-width:0"><%= r.label %><% if (!r.required) { %> <span class="badge" style="margin-left:4px">Optional</span><% } %></span>
            </span>
            <% if (flagged) { %><span class="badge badge-danger">Reported to admin</span><% } %>
          </label>
          <% if (verified) { %><p class="text-sm text-muted" style="margin:4px 0 0 26px">Verified by <%= row.item.verifiedBy ? row.item.verifiedBy.fullName : 'management' %><%= row.item.verifiedAt ? ' on ' + row.item.verifiedAt.toLocaleDateString('en-US') : '' %>.</p><% } %>
          <% if (selfCompleted) { %><p class="text-sm text-muted" style="margin:4px 0 0 26px">Confirmed by you on <%= row.item.employeeConfirmedAt.toLocaleDateString('en-US') %>.</p><% } %>
          <% if (row.awaitingVerification) { %><p class="text-sm text-muted" style="margin:4px 0 0 26px">Confirmed by you — awaiting verification by a supervisor or administrator. Untick and save to withdraw.</p><% } %>
          <% if (flagged && row.item && row.item.note) { %><p class="text-sm" style="margin:4px 0 0 26px">Your note: <%= row.item.note %></p><% } %>
          <% if (!haveChecked) { %>
          <details style="margin:4px 0 0 26px">
            <summary class="text-sm link-gold" style="cursor:pointer"><%= flagged ? 'Update my note' : "I haven't" %></summary>
            <div class="mt-8">
              <textarea name="note" form="issue-form-<%= r.id %>" <%= viewOnly ? 'disabled' : '' %> rows="2" maxlength="500" required placeholder="What is missing or not working? This is sent to your administrator."><%= flagged && row.item ? (row.item.note || '') : '' %></textarea>
              <button type="submit" form="issue-form-<%= r.id %>" <%= viewOnly ? 'disabled' : '' %> class="btn btn-secondary btn-sm" style="margin-top:6px">Send to administrator</button>
            </div>
          </details>
          <% } %>
          <% if (!verified) { %><input type="hidden" name="ts_<%= r.id %>" value="<%= row.item ? row.item.updatedAt.toISOString() : '' %>" /><% } %>
        </li>
        <% }); %>
      </ul>
      <div class="card-body row-between" style="border-top:1px solid var(--border-subtle)">
        <span class="text-sm text-muted" data-unsaved-hint>No changes yet</span>
        <button type="submit" class="btn btn-gold" <%= viewOnly ? 'disabled' : '' %> data-bulk-save>Save Changes</button>
      </div>
    </form>
    <%
      // Each "I haven't" note belongs to its own real, empty form rendered OUTSIDE the checklist form
      // and bound with form="issue-form-<id>" — nested <form> elements are invalid HTML and would cut
      // the checklist form short (same technique as the manage checklist's per-item editor).
    %>
    <% selfBulkEligible.forEach(function (row) { if (row.status === 'COMPLETED' || row.status === 'IN_PROGRESS') return; %><form id="issue-form-<%= row.requirement.id %>" method="post" action="/employees/<%= employee.id %>/setup/<%= row.requirement.id %>/report-issue" hidden></form><% }); %>
  </div>
  <% } %>

  <% if (otherSelfRows.length) { %>
  <div class="card mt-24">
    <div class="card-header"><div><h2><%= selfBulkEligible.length ? 'Other items' : 'Checklist' %></h2><% if (selfBulkEligible.length) { %><p>Company accounts (WhatsApp, Telegram), passwords, and details that are calculated automatically or completed by management.</p><% } %></div></div>
    <div class="card-body">
      <div class="grid grid-3">
        <% otherSelfRows.forEach(function (row) { %>
          <% const r = row.requirement; const done = row.status === 'COMPLETED';
             const actionHref = r.kind === 'CREDENTIAL_VAULT' ? '/employees/' + employee.id + '/credentials' : (r.kind === 'LOCAL_PHONE' || r.kind === 'ADDRESS') ? '#contact-card' : r.kind === 'PASSPORT' ? '#passport-card' : '';
             const actionLabel = r.kind === 'CREDENTIAL_VAULT' ? (isSelf ? 'Add my logins & passwords' : 'Open vault') : (r.kind === 'LOCAL_PHONE' || r.kind === 'ADDRESS') ? 'Add contact details' : r.kind === 'PASSPORT' ? 'Add passport details' : ''; %>
          <div class="card" style="padding:16px">
            <p style="font-weight:600;color:var(--navy-950)">
              <span aria-hidden="true"><%= done ? '✓' : row.status === 'NOT_REQUIRED' ? '–' : '✗' %></span>
              <%= r.label %>
              <% if (!r.required) { %><span class="badge" style="margin-left:6px">Optional</span><% } %>
            </p>
            <p class="text-sm text-muted mt-4"><%= r.category || 'Other' %><% if (!row.derived) { %> · <%= VERIFICATION_LABEL[row.rule] %><% } %></p>
            <% if (r.description) { %><p class="text-sm text-muted mt-4"><%= r.description %></p><% } %>
            <p class="text-sm text-muted mt-4">
              <% if (row.derived) { %>Calculated from real data<% if (r.kind === 'CREDENTIAL_VAULT') { %> — contents of the vault are never shown here<% } %>.<% if (row.vault) { %> Saved <%= row.vault.saved %> of <%= row.vault.total %> required systems<%= row.vault.missing.length ? ' - still needed: ' + row.vault.missing.join(', ') : '' %>.<% } %><% } else if (r.companyControlled) { %>Company-controlled — set up with the company.<% } else if (isSelf && row.rule === 'MANAGEMENT_ONLY') { %>Only your supervisor or an administrator can complete this.<% } %>
              <% if (row.item && row.item.verifiedAt && done) { %> Verified by <%= row.item.verifiedBy ? row.item.verifiedBy.fullName : 'management' %> on <%= row.item.verifiedAt.toLocaleDateString('en-US') %>.<% } %>
              <% if (row.awaitingCompanyControl) { %> Waiting for company ownership/recovery confirmation.<% } %>
            </p>
            <% if (r.companyControlled && row.item && row.item.accountType === 'PERSONAL_WORK') { %><p class="text-sm mt-4">Personal number — used for work.</p>
            <% } else if (r.companyControlled && row.item && row.item.companyNumber) { %><p class="text-sm mt-4">Company number/account: <%= row.item.companyNumber %></p><% } %>
            <% if (row.item && row.item.note) { %><p class="text-sm mt-4">Note: <%= row.item.note %></p><% } %>
            <% if (isSelf && !viewOnly && !setup.notStarted && r.kind === 'MANUAL' && r.companyControlled && row.status !== 'NOT_REQUIRED' && !(done && row.item && row.item.verifiedById)) { %>
            <form method="post" action="/employees/<%= employee.id %>/setup/<%= r.id %>/account" class="mt-8" autocomplete="off" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
              <input name="companyNumber" maxlength="40" required value="<%= row.item && row.item.companyNumber ? row.item.companyNumber : '' %>" placeholder="<%= r.key === 'telegram' ? 'Your Telegram number or @username' : 'Your ' + r.label + ' number, e.g. +998 90 123 45 67' %>" aria-label="Your <%= r.label %> number" style="flex:1;min-width:150px" />
              <button type="submit" class="btn btn-secondary btn-sm"><%= done ? 'Update' : 'Save' %></button>
            </form>
            <% } %>
            <p class="mt-8"><span class="badge <%= done ? 'badge-success' : row.status === 'ISSUE' ? 'badge-danger' : row.status === 'NOT_REQUIRED' ? '' : 'badge-warning' %>"><%= STATUS_LABEL[row.status] %></span></p>
            <% if (isSelf && actionHref && !done && (r.kind !== 'CREDENTIAL_VAULT' || tabs.some(function (t) { return /\/credentials$/.test(t.href); }))) { %><p class="mt-8"><a class="link-gold text-sm" href="<%= actionHref %>"><%= actionLabel %> &rarr;</a></p><% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>
<% } %>

<% if (setup.history && setup.history.length) { %>
<div class="card mt-24">
  <div class="card-header"><h2>Earlier requirements</h2><p>No longer required. Kept as history and not counted in setup progress.</p></div>
  <ul class="divide-list" style="padding:0 24px">
    <% setup.history.forEach(function (h) { %>
      <li class="row-between">
        <span><%= h.requirement.label %> <span class="text-sm text-muted">· <%= h.requirement.category || 'Other' %></span></span>
        <span class="text-sm text-muted"><%= STATUS_LABEL[h.item.status] %><% if (h.item.verifiedAt) { %> · verified <%= h.item.verifiedAt.toLocaleDateString('en-US') %><% } %></span>
      </li>
    <% }); %>
  </ul>
</div>
<% } %>
<% if (passAccess.statusVisible) { %>
<div class="card mt-24" id="passport-card">
  <div class="card-header row-between">
    <h2>Passport Details</h2>
    <% if (passStatus) { %><span class="badge <%= PASSPORT_STATUS_TONE[passStatus] %>"><%= PASSPORT_STATUS_LABEL[passStatus] %></span><% } %>
  </div>
  <div class="card-body">
    <% if (!employee.passportNumberEnc) { %>
      <%- include('../partials/empty-state', { title: 'Passport Details Required', description: 'The name, passport number and expiration date have not been added yet.' }) %>
    <% } else if (!passAccess.view) { %>
      <p class="text-sm text-muted">Passport on file. Status: <span class="badge <%= PASSPORT_STATUS_TONE[passStatus] %>"><%= PASSPORT_STATUS_LABEL[passStatus] %></span></p>
      <p class="text-sm text-muted mt-4">The Passport Number itself is not visible with your current access.</p>
    <% } else { %>
      <% const passportName = [employee.passportFirstName, employee.passportMiddleName, employee.passportLastName].filter(Boolean).join(' '); %>
      <% if (passportName) { %><p class="text-sm text-muted">Name: <strong><%= passportName %></strong></p><% } else { %><p class="text-sm text-muted">Name on passport not added yet.</p><% } %>
      <p class="text-sm text-muted">Date of birth: <% if (dateOfBirth) { %><strong><%= new Date(dateOfBirth + 'T00:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) %></strong><% } else { %>not added yet<% } %></p>
      <p class="text-sm text-muted">Number: <strong><%= passportFull || passportMasked %></strong><% if (passportExpiresAt) { %> · Expires <%= new Date(passportExpiresAt).toLocaleDateString('en-US') %><% } %></p>
      <% if (passStatus === 'EXPIRED') { %><p class="text-sm" style="color:var(--red-600);margin-top:6px">This passport has expired.</p><% } %>
      <% if (passportMasked && !passportFull) { %>
        <form class="passport-reveal-form" data-reveal-url="/employees/<%= employee.id %>/passport/reveal" style="display:flex;gap:6px;align-items:center;margin-top:10px">
          <input type="password" name="password" placeholder="Your password" autocomplete="current-password" required style="width:150px" />
          <button type="submit" class="btn btn-secondary btn-sm">Reveal full number</button>
        </form>
        <div class="passport-reveal-output text-sm mt-16" hidden style="background:var(--navy-50, #f4f6fa);border-radius:8px;padding:10px 12px"></div>
      <% } %>
    <% } %>

    <% if (passAccess.manage) { %>
      <details class="mt-16" <%= !employee.passportNumberEnc ? 'open' : '' %>>
        <summary class="text-sm link-gold" style="cursor:pointer"><%= employee.passportNumberEnc ? 'Update passport details' : 'Add passport details' %></summary>
        <form method="post" action="/employees/<%= employee.id %>/passport" class="mt-16" autocomplete="off">
          <div class="grid grid-3">
            <div class="field">
              <label for="passportFirstName">First name</label>
              <input id="passportFirstName" name="passportFirstName" maxlength="60" autocomplete="off" required value="<%= employee.passportFirstName || '' %>" />
            </div>
            <div class="field">
              <label for="passportMiddleName">Middle name <span class="text-muted">(optional)</span></label>
              <input id="passportMiddleName" name="passportMiddleName" maxlength="60" autocomplete="off" value="<%= employee.passportMiddleName || '' %>" />
            </div>
            <div class="field">
              <label for="passportLastName">Last name</label>
              <input id="passportLastName" name="passportLastName" maxlength="60" autocomplete="off" required value="<%= employee.passportLastName || '' %>" />
            </div>
          </div>
          <p class="hint">Exactly as printed in the passport.</p>
          <div class="grid grid-3 mt-16">
            <div class="field">
              <label for="passportNumber">Passport number</label>
              <input id="passportNumber" name="passportNumber" maxlength="20" autocomplete="off" value="<%= isSelf ? (passportFull || '') : '' %>" placeholder="<%= employee.passportNumberEnc && !isSelf ? 'Leave blank to keep the current number' : '' %>" />
            </div>
            <div class="field">
              <label for="passportExpiresAt">Expiration date</label>
              <input id="passportExpiresAt" name="passportExpiresAt" type="date" value="<%= passportExpiresAt %>" required />
            </div>
            <div class="field">
              <label for="dateOfBirth">Date of birth</label>
              <input id="dateOfBirth" name="dateOfBirth" type="date" min="1900-01-01" max="<%= new Date().toISOString().slice(0, 10) %>" value="<%= dateOfBirth %>" required />
            </div>
          </div>
          <p class="hint">Only the name, number, expiration date and date of birth are stored — never a scan or photo. The number is encrypted at rest and masked from management by default. We use the date of birth to send a birthday greeting.</p>
          <button type="submit" class="btn btn-gold mt-16"><%= employee.passportNumberEnc ? 'Save changes' : 'Save passport details' %></button>
        </form>
      </details>
    <% } %>
  </div>
</div>
<script>
(function () {
  document.querySelectorAll('.passport-reveal-form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var out = form.parentElement.querySelector('.passport-reveal-output');
      var body = new URLSearchParams(new FormData(form));
      fetch(form.getAttribute('data-reveal-url'), { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          form.querySelector('input[name=password]').value = '';
          out.hidden = false;
          if (!r.ok) { out.textContent = r.data.error || 'Could not reveal.'; return; }
          out.textContent = 'Passport number: ' + r.data.passportNumber + ' — hides automatically in 30 seconds.';
          setTimeout(function () { out.textContent = ''; out.hidden = true; }, 30000);
        })
        .catch(function () { out.hidden = false; out.textContent = 'Could not reveal.'; });
    });
  });
})();
</script>
<% } %>
<div class="card mt-24" id="contact-card" style="margin-bottom:40px">
  <div class="card-header"><h2>Contact &amp; address</h2><p>Sensitive personal information — shown only on this authorized profile.</p></div>
  <div class="card-body">
    <% if (canEditContact) { %>
      <form method="post" action="/employees/<%= employee.id %>/contact">
        <div class="grid grid-2">
          <div class="field">
            <label for="localPhone">Local phone number</label>
            <input id="localPhone" name="localPhone" value="<%= employee.localPhone || '' %>" placeholder="+998 90 123 45 67" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="currentAddress">Current living address</label>
            <textarea id="currentAddress" name="currentAddress" rows="2" maxlength="500" autocomplete="street-address"><%= address %></textarea>
            <p class="hint">Stored encrypted. Never shown in employee lists, search, dashboards or logs.</p>
          </div>
        </div>
        <button type="submit" class="btn btn-gold mt-16">Save contact details</button>
      </form>
    <% } else { %>
      <p class="text-sm text-muted">Phone: <%= employee.localPhone || '—' %></p>
    <% } %>
  </div>
</div>
<% if (manage || isSelf) { %><script src="<%= asset('/static/js/setup-bulk.js') %>" defer></script><% } %>
