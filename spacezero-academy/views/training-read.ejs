<%#
  The reading page for one piece of training material: the file as it was uploaded (PDF pages, the Word document, the
  slides, the picture), with a line at the bottom that fills as the learner reads and finishes the item at the end.
  Locals: module, course, kind (pdf | docx | slides | image | unsupported), html (docx), slides (pptx), protect, tracked, saved.
%>
<%- include('partials/page-header', { pageTitle: module.title, pageDescription: course.title }) %>
<% const draftSource = course.origin === 'AI_PRACTICE' && course.status !== 'PUBLISHED'; %>
<div style="margin-bottom:12px"><a href="<%= draftSource ? '/ai-practice/' + course.id : '/training-course/' + course.id %>" class="text-sm link-gold">← <%= draftSource ? 'Back to the source material' : 'Back to the training' %></a></div>

<div class="card">
  <div class="card-body<%= protect ? ' no-copy' : '' %>" <%- protect ? 'data-protect' : '' %>>
    <% if (module.description) { %><p class="text-sm" style="margin-bottom:16px"><%= module.description %></p><% } %>

    <%- include('partials/doc-reader-body') %>

    <% if (protect) { %>
      <p class="text-sm text-muted mt-24">Viewing in-browser only. Downloading and copying material is restricted to administrators.</p>
    <% } else { %>
      <p class="text-sm mt-24"><a class="link-gold" href="/training-file/<%= module.id %>?download=1">Download (administrators only)</a></p>
    <% } %>
  </div>
</div>

<%- include('partials/doc-reader-progress') %>

<% if (protect) { %><script src="<%= asset('/static/js/protect-materials.js') %>" defer></script><% } %>
<% if (kind === 'pdf') { %><script src="/static/vendor/pdfjs/pdf.min.js"></script><% } %>
<% if (kind !== 'unsupported') { %><script src="<%= asset('/static/js/doc-reader.js') %>" defer></script><% } %>
