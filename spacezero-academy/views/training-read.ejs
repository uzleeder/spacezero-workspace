<%#
  The reading page for one piece of training material: the file as it was uploaded (PDF pages, the Word document, the
  slides, the picture), with a line at the bottom that fills as the learner reads and finishes the item at the end.
  Locals: module, course, kind (pdf | docx | slides | image | unsupported), html (docx), slides (pptx), protect, tracked, saved.
%>
<%- include('partials/page-header', { pageTitle: module.title, pageDescription: course.title }) %>
<div style="margin-bottom:12px"><a href="/training-course/<%= course.id %>" class="text-sm link-gold">← Back to the training</a></div>

<%
  const pageCount = kind === 'slides' && slides ? slides.length : 1;
  const paper = kind === 'docx' || kind === 'slides' || kind === 'pdf' || kind === 'image';
%>
<div class="card">
  <div class="card-body<%= protect ? ' no-copy' : '' %>" <%- protect ? 'data-protect' : '' %>>
    <% if (module.description) { %><p class="text-sm" style="margin-bottom:16px"><%= module.description %></p><% } %>

    <div class="doc-reader" data-doc-reader
         data-kind="<%= kind %>" data-tracked="<%= tracked ? 'true' : 'false' %>" data-saved="<%= saved.percent %>" data-done="<%= saved.done ? 'true' : 'false' %>"
         data-progress-url="/training-material/<%= module.id %>/progress" data-file-url="/training-file/<%= module.id %>" data-pages="<%= pageCount %>">
      <% if (kind === 'pdf') { %>
        <div class="doc-reader__pages" data-reader-body aria-label="<%= module.title %>"></div>
        <p class="text-sm text-muted doc-reader__loading" data-reader-loading>Opening the document…</p>
      <% } else if (kind === 'docx') { %>
        <article class="doc-reader__paper" data-reader-body aria-label="<%= module.title %>"><%- html %></article>
      <% } else if (kind === 'slides') { %>
        <div class="doc-reader__slides" data-reader-body aria-label="<%= module.title %>">
          <% slides.forEach(function (s) { %>
            <section class="doc-reader__slide">
              <p class="doc-reader__slide-no">Slide <%= s.number %> of <%= slides.length %></p>
              <% if (s.title) { %><h2><%= s.title %></h2><% } %>
              <% s.images.forEach(function (src) { %><img src="<%= src %>" alt="" draggable="false"><% }); %>
              <% if (s.lines.length) { %><ul><% s.lines.forEach(function (line) { %><li><%= line %></li><% }); %></ul><% } %>
            </section>
          <% }); %>
        </div>
      <% } else if (kind === 'image') { %>
        <div class="doc-reader__image" data-reader-body><img src="/training-file/<%= module.id %>" alt="<%= module.title %>" draggable="false"></div>
      <% } else { %>
        <div class="form-alert info" data-reader-unsupported>This file cannot be shown page by page here. <%= protect ? 'Ask an administrator to upload it as a PDF, DOCX or PPTX file.' : '' %></div>
        <% if (tracked && !saved.done) { %>
          <form method="post" action="/training-material/<%= module.id %>/acknowledge" class="mt-16" data-once>
            <button type="submit" class="btn btn-gold">I have read this</button>
            <span class="text-sm text-muted" style="margin-left:8px">Available after you have had a little time with it.</span>
          </form>
        <% } %>
      <% } %>
    </div>

    <% if (protect) { %>
      <p class="text-sm text-muted mt-24">Viewing in-browser only. Downloading and copying material is restricted to administrators.</p>
    <% } else { %>
      <p class="text-sm mt-24"><a class="link-gold" href="/training-file/<%= module.id %>?download=1">Download (administrators only)</a></p>
    <% } %>
  </div>
</div>

<% if (kind !== 'unsupported') { %>
  <div class="doc-progress" data-doc-progress role="status" aria-live="polite">
    <div class="doc-progress__row">
      <span class="doc-progress__label" data-progress-label><%= saved.done ? '✓ Finished' : (tracked ? 'Reading progress' : 'Preview — progress is not recorded') %></span>
      <span class="doc-progress__percent" data-progress-percent><%= saved.done ? 100 : saved.percent %>%</span>
    </div>
    <div class="doc-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= saved.done ? 100 : saved.percent %>" data-progress-track>
      <div class="doc-progress__fill" data-progress-fill style="width:<%= saved.done ? 100 : saved.percent %>%"></div>
    </div>
    <p class="doc-progress__note" data-progress-note><%= saved.done ? 'This item is finished.' : (tracked ? 'Read to the end — the line fills as you read and finishes this item by itself.' : '') %> <a href="/training-course/<%= course.id %>" class="link-gold" data-progress-back <%= saved.done ? '' : 'hidden' %>>Back to the training →</a></p>
  </div>
<% } %>

<% if (protect) { %><script src="<%= asset('/static/js/protect-materials.js') %>" defer></script><% } %>
<% if (kind === 'pdf') { %><script src="/static/vendor/pdfjs/pdf.min.js"></script><% } %>
<% if (kind !== 'unsupported') { %><script src="<%= asset('/static/js/doc-reader.js') %>" defer></script><% } %>
