<%# My Training: ONE path through the learner's training (lib/myTraining.js pathOf). One main button, on the current
    step; finished steps fold into "✓ N completed"; only the next 3 locked steps show, the rest fold into "+N more". %>
<%- include('partials/page-header', { pageTitle: 'My Training', pageDescription: 'Finish each training to unlock the next.' }) %>

<% if (!path.total) { %>
  <div class="card mt-24" data-path-empty><div class="card-body"><%- include('partials/empty-state', profile.role === 'ADMIN'
    ? { title: 'Nothing is assigned to you', description: 'Training you assign to others is in Manage Training.' }
    : { title: 'No training assigned yet', description: 'When training is assigned to you, it shows up here.' }) %></div></div>
<% } else { %>
<div class="path" data-path>
  <div class="path-progress">
    <p class="path-progress__label"><strong><%= path.doneCount %> of <%= path.total %></strong> completed</p>
    <div class="read-line" role="progressbar" aria-label="Training completed" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= path.percent %>"><div class="read-line__track"><div class="read-line__fill" style="width:<%= path.percent %>%"></div></div><span class="read-line__percent"><%= path.percent %>%</span></div>
  </div>

  <% if (!path.current) { %>
    <section class="card next-card mt-24 path-finished" data-path-done>
      <div class="card-body">
        <span class="path-marker path-marker--done" aria-hidden="true"><%- include('partials/icon', { name: 'check' }) %></span>
        <div><h2>You've completed all your training</h2><p class="text-sm text-muted">New training shows up here as soon as it is assigned.</p></div>
      </div>
    </section>
  <% } %>

  <ol class="path-steps">
    <% if (path.completed.length) { %>
      <li class="path-step path-step--done">
        <span class="path-marker path-marker--done" aria-hidden="true"><%- include('partials/icon', { name: 'check' }) %></span>
        <details class="path-fold" data-fold="completed"<%= path.current ? '' : ' open' %>>
          <summary><%= path.doneCount %> completed</summary>
          <ol class="path-fold__list">
            <% path.completed.forEach(function (s) { %>
              <li data-step="done"><a href="<%= s.href %>"><%= s.title %></a><span><%= s.completedText %></span></li>
            <% }); %>
          </ol>
        </details>
      </li>
    <% } %>

    <% if (path.current) { const c = path.current; %>
      <li class="path-step path-step--current" aria-current="step">
        <span class="path-marker path-marker--current" aria-hidden="true"><%= c.number %></span>
        <section class="card next-card path-current" data-current-step aria-labelledby="current-step-title">
          <div class="card-body">
            <p class="label">Step <%= c.number %> of <%= path.total %></p>
            <h2 id="current-step-title"><%= c.title %></h2>
            <% if (c.progressText) { %><p class="path-current__progress"><%= c.progressText %></p><% } %>
            <% if (c.dueText) { %><p class="path-due<%= c.overdue ? ' path-due--late' : '' %>"><%= c.dueText %></p><% } %>
            <a class="btn btn-gold path-current__action" href="<%= c.resumeHref %>" data-main-action><%= path.action %></a>
            <% if (c.retake) { %><p class="path-current__hint">Pass the quiz again to finish this step</p><% } %>
          </div>
        </section>
      </li>
    <% } %>

    <% path.upcomingShown.forEach(function (s) { %>
      <li class="path-step path-step--locked" data-step="locked">
        <span class="path-marker path-marker--locked" aria-hidden="true"><%- include('partials/icon', { name: 'lock' }) %></span>
        <div class="path-locked"><p class="path-locked__title"><%= s.title %></p><p class="path-locked__meta">Step <%= s.number %><% if (s.dueText) { %> · <span class="<%= s.overdue ? 'path-due--late' : '' %>"><%= s.dueText %></span><% } %></p></div>
      </li>
    <% }); %>

    <% if (path.upcomingMore.length) { %>
      <li class="path-step path-step--locked">
        <span class="path-marker path-marker--locked" aria-hidden="true"><%- include('partials/icon', { name: 'lock' }) %></span>
        <details class="path-fold" data-fold="more">
          <summary>+<%= path.upcomingMore.length %> more</summary>
          <ol class="path-fold__list">
            <% path.upcomingMore.forEach(function (s) { %>
              <li data-step="locked"><span class="path-fold__title"><%= s.title %></span><span>Step <%= s.number %><% if (s.dueText) { %> · <span class="<%= s.overdue ? 'path-due--late' : '' %>"><%= s.dueText %></span><% } %></span></li>
            <% }); %>
          </ol>
        </details>
      </li>
    <% } %>
  </ol>
</div>
<% } %>
