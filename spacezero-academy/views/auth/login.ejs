<!doctype html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=1" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in · SpaceZero Workspace</title>
  <link rel="stylesheet" href="<%= asset('/static/css/styles.css') %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600&display=swap" />
</head>
<body>
  <%- include('../partials/intro') %>
  <div class="auth-shell" style="position:relative">
    <form method="post" action="/theme" style="position:absolute;top:20px;right:20px">
      <input type="hidden" name="theme" value="<%= theme === 'dark' ? 'light' : 'dark' %>" />
      <button type="submit" class="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      </button>
    </form>
    <div class="auth-box">
      <div class="auth-brand">
        <%- include('../partials/brand-mark', { brandVariant: 'light' }) %>
      </div>
      <h1>Sign in to your account</h1>
      <p class="subtitle">SpaceZero Workspace — Above9 Travel internal platform</p>

      <% if (reset) { %>
        <div class="form-alert success mt-16">Your password has been updated. You can sign in now.</div>
      <% } %>
      <% if (error) { %>
        <div class="form-alert error mt-16"><%= error %></div>
      <% } %>

      <form class="auth-form" method="post" action="/login">
        <input type="hidden" name="next" value="<%= next %>" />
        <div class="field">
          <label for="identifier">Username or email</label>
          <input id="identifier" name="identifier" placeholder="first.last or email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <div class="field">
          <label for="companyCode">Company code</label>
          <input id="companyCode" name="companyCode" placeholder="Company code" required />
        </div>
        <div class="row-between mt-16" style="justify-content:flex-end">
          <a href="/forgot-password" class="text-sm link-gold">Forgot your password?</a>
        </div>
        <button type="submit" class="btn btn-gold mt-16" style="width:100%">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
