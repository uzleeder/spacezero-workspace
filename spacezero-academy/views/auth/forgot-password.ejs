<!doctype html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=1" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Reset password · SpaceZero Academy</title>
  <link rel="stylesheet" href="/static/css/styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600&display=swap" />
</head>
<body>
  <div class="auth-shell" style="position:relative">
    <form method="post" action="/theme" style="position:absolute;top:20px;right:20px">
      <input type="hidden" name="theme" value="<%= theme === 'dark' ? 'light' : 'dark' %>" />
      <button type="submit" class="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      </button>
    </form>
    <div class="auth-box">
      <div class="auth-brand">
        <%- include('../partials/brand-mark', { brandVariant: 'light' }) %>
      </div>
      <h1>Reset your password</h1>
      <p class="subtitle">Enter your registered email address.</p>

      <% if (sent) { %>
        <div class="form-alert success mt-16">If that email is registered, you will receive a password reset email.</div>
        <% if (devResetLink) { %>
          <div class="form-alert info mt-16">
            <p><strong>Local mode:</strong> no SMTP is connected, so the link is shown here instead of being emailed.</p>
            <a href="<%= devResetLink %>"><%= devResetLink %></a>
          </div>
        <% } %>
        <a href="/login" class="text-sm link-gold" style="display:block;margin-top:16px">&larr; Back to sign in</a>
      <% } else { %>
        <% if (error) { %><div class="form-alert error mt-16"><%= error %></div><% } %>
        <form class="auth-form" method="post" action="/forgot-password">
          <div class="field">
            <label for="email">Registered email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
            <p class="hint">We'll email you a secure password reset link.</p>
          </div>
          <button type="submit" class="btn btn-gold mt-16" style="width:100%">Get reset link</button>
        </form>
        <a href="/login" class="text-sm link-gold" style="display:block;margin-top:16px;text-align:center">&larr; Back to sign in</a>
      <% } %>
    </div>
  </div>
</body>
</html>
