<%- include('../partials/page-header', { pageTitle: 'My Library', pageDescription: "Materials you've favorited, plus what you've viewed recently." }) %>

<div class="card">
  <div class="card-header"><h2>Favorites</h2><span class="badge" data-favorite-count><%= favorites.length %></span></div>
  <div class="card-body">
    <div data-favorite-empty <%= favorites.length === 0 ? '' : 'hidden' %>>
      <%- include('../partials/empty-state', { title: 'No favorites yet', description: 'Tap the star on any library item to save it here.' }) %>
    </div>
    <ul class="divide-list" <%= favorites.length === 0 ? 'hidden' : '' %>>
      <% favorites.forEach(function (f) { %>
        <li class="row-between" data-favorite-row>
          <a href="/library/<%= f.libraryItem.id %>" style="font-weight:500;color:var(--navy-950)"><%= f.libraryItem.title %></a>
          <button type="button" class="btn btn-ghost btn-sm is-active" data-favorite-toggle="<%= f.libraryItem.id %>" aria-pressed="true" aria-label="Remove from My Library" title="Remove from My Library">★</button>
        </li>
      <% }); %>
    </ul>
  </div>
</div>

<div class="card mt-24">
  <div class="card-header"><h2>Recently viewed</h2></div>
  <div class="card-body">
    <% if (recent.length === 0) { %>
      <%- include('../partials/empty-state', { title: 'Nothing viewed yet' }) %>
    <% } else { %>
      <ul class="divide-list">
        <% recent.forEach(function (r) { %>
          <li>
            <a href="/library/<%= r.libraryItem.id %>" style="font-weight:500;color:var(--navy-950)"><%= r.libraryItem.title %></a>
            <p class="text-sm text-muted">Viewed <%= r.viewedAt.toLocaleString('en-US') %></p>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>
