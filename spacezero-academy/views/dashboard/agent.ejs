<%# The Agent dashboard: what do I do next (lib/agentDashboard.js). The same page for every agent; each part shows
    only while it has something to do. It refreshes itself every minute and when the tab is shown again
    (public/js/dashboard-live.js reloads /dashboard/live into #dash-live). %>
<div class="dash ag-dash" id="dash-live" data-live="/dashboard/live" aria-live="polite">
  <%- include('agent-board', { adash: adash, greeting: greeting, today: today }) %>
</div>
<script src="<%= asset('/static/js/dashboard-live.js') %>" defer></script>
