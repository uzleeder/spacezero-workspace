<%# The Supervisor dashboard, at a glance (lib/supervisorDashboard.js). The board refreshes itself every minute and when
    the tab is shown again (public/js/dashboard-live.js reloads /dashboard/live into #dash-live). %>
<div class="dash" id="dash-live" data-live="/dashboard/live" aria-live="polite">
  <%- include('supervisor-board', { sdash: sdash, greeting: greeting, today: today }) %>
</div>
<script src="<%= asset('/static/js/dashboard-live.js') %>" defer></script>
