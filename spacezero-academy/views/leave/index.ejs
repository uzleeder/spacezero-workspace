<%
const qs = function (extra) {
  const p = new URLSearchParams();
  Object.entries(Object.assign({}, filters, { view: view, month: month }, extra)).forEach(function (e) { if (e[1]) p.set(e[0], e[1]); });
  return '/leave?' + p.toString();
};
const monthDate = new Date(month + '-01T00:00:00Z');
const prevMonth = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() - 1, 1)).toISOString().slice(0, 7);
const nextMonth = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() + 1, 1)).toISOString().slice(0, 7);
const todayIso = new Date().toISOString().slice(0, 10);
const thisMonth = todayIso.slice(0, 7);
// "Oct 21 – 25, 2026", "Oct 30 – Nov 2, 2026", "Dec 30, 2026 – Jan 2, 2027" or "Oct 21, 2026".
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dateRange = function (a, b) {
  const md = function (d) { return MONTHS[d.getUTCMonth()] + ' ' + d.getUTCDate(); };
  const y1 = a.getUTCFullYear(), y2 = b.getUTCFullYear();
  if (a.toISOString().slice(0, 10) === b.toISOString().slice(0, 10)) return md(a) + ', ' + y1;
  if (y1 !== y2) return md(a) + ', ' + y1 + ' – ' + md(b) + ', ' + y2;
  if (a.getUTCMonth() === b.getUTCMonth()) return md(a) + ' – ' + b.getUTCDate() + ', ' + y1;
  return md(a) + ' – ' + md(b) + ', ' + y1;
};
%>
<%- include('../partials/page-header', { pageTitle: 'Employees & Teams', pageDescription: profile.role === 'SUPERVISOR' ? 'Vacation overview: leave requests from your assigned team.' : 'Vacation overview: leave requests across the organization.' }) %>
<%- include('../partials/management-tabs', { tabs: tabsets.employees, sticky: true }) %>

<div class="card mt-24">
  <form class="filter-bar" method="get" action="/leave">
    <input type="hidden" name="view" value="<%= view %>" /><input type="hidden" name="month" value="<%= month %>" />
    <select name="status" aria-label="Status"><option value="">All statuses</option><% Object.keys(leave.STATUS_LABEL).forEach(function (s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= leave.STATUS_LABEL[s] %></option><% }); %></select>
    <select name="teamId" aria-label="Team"><option value="">All teams</option><% teams.forEach(function (t) { %><option value="<%= t.id %>" <%= filters.teamId === t.id ? 'selected' : '' %>><%= t.name %></option><% }); %></select>
    <% if (supervisors.length) { %><select name="supervisorId" aria-label="Supervisor"><option value="">All supervisors</option><% supervisors.forEach(function (s) { %><option value="<%= s.id %>" <%= filters.supervisorId === s.id ? 'selected' : '' %>><%= s.fullName %></option><% }); %></select><% } %>
    <select name="profileId" aria-label="Employee"><option value="">All employees</option><% people.forEach(function (p) { %><option value="<%= p.id %>" <%= filters.profileId === p.id ? 'selected' : '' %>><%= p.fullName %></option><% }); %></select>
    <label class="filter-date"><span>From</span><input type="date" name="from" value="<%= filters.from %>" aria-label="From date" /></label>
    <label class="filter-date"><span>To</span><input type="date" name="to" value="<%= filters.to %>" aria-label="To date" /></label>
    <button type="submit" class="btn btn-secondary">Filter</button>
    <div class="filter-bar__end">
      <nav class="segmented" aria-label="View">
        <a class="segmented__item<%= view === 'list' ? ' is-active' : '' %>" href="<%= qs({ view: 'list' }) %>"<%- view === 'list' ? ' aria-current="page"' : '' %>>List view</a>
        <a class="segmented__item<%= view === 'calendar' ? ' is-active' : '' %>" href="<%= qs({ view: 'calendar' }) %>"<%- view === 'calendar' ? ' aria-current="page"' : '' %>>Calendar view</a>
      </nav>
      <a class="badge badge-warning pending-chip" href="<%= qs({ status: 'PENDING' }) %>" title="Show only pending requests"><%= pendingCount %> pending</a>
    </div>
  </form>
</div>

<% if (view === 'calendar' && calendar) { %>
  <div class="card mt-24" style="margin-bottom:40px">
    <div class="card-header row-between">
      <h2><%= monthDate.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) %></h2>
      <div class="cal-nav">
        <a class="btn btn-secondary btn-sm" href="<%= qs({ month: prevMonth }) %>">← Previous</a>
        <a class="btn btn-ghost btn-sm<%= month === thisMonth ? ' is-current' : '' %>" href="<%= qs({ month: thisMonth }) %>">Today</a>
        <a class="btn btn-secondary btn-sm" href="<%= qs({ month: nextMonth }) %>">Next →</a>
      </div>
    </div>
    <div class="table-wrap">
      <table class="cal-table" style="table-layout:fixed">
        <thead><tr><% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(function (d) { %><th><%= d %></th><% }); %></tr></thead>
        <tbody>
          <% calendar.weeks.forEach(function (week) { %>
            <tr>
              <% week.forEach(function (cell) { %>
                <td style="vertical-align:top;height:92px;<%= cell.inMonth ? '' : 'opacity:.45' %>"<%- cell.date.toISOString().slice(0, 10) === todayIso ? ' class="cal-today" aria-current="date"' : '' %>>
                  <div class="text-sm text-muted cal-day"><%= cell.date.getUTCDate() %></div>
                  <% cell.entries.slice(0, 3).forEach(function (r) { %>
                    <a href="/leave/<%= r.id %>" class="cal-entry <%= r.status === 'PENDING' ? 'is-pending' : 'is-approved' %>" title="<%= r.profile.fullName %> · <%= leave.STATUS_LABEL[r.status] %>"><%= r.profile.fullName %><% if (r.status === 'PENDING') { %><span class="visually-hidden"> (pending)</span><% } %></a>
                  <% }); %>
                  <% if (cell.entries.length > 3) { %><span class="text-sm text-muted">+<%= cell.entries.length - 3 %> more</span><% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="card mt-24" style="margin-bottom:40px">
    <% if (requests.length === 0) { %>
      <div class="card-body"><%- include('../partials/empty-state', { title: 'No leave requests match', description: 'Adjust the filters.' }) %></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table-zebra table-compact">
          <thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% requests.forEach(function (r) { %>
              <tr data-href="/leave/<%= r.id %>">
                <td><a href="/employees/<%= r.profile.id %>/leave" title="All leave for <%= r.profile.fullName %>"><%= r.profile.fullName %></a></td>
                <td><%= leave.TYPE_LABEL[r.leaveType] %></td>
                <td style="white-space:nowrap"><%= dateRange(r.startDate, r.endDate) %></td>
                <td><%= r.days %></td>
                <td><span class="badge <%= r.status === 'APPROVED' ? 'badge-success' : r.status === 'REJECTED' ? 'badge-danger' : r.status === 'PENDING' ? 'badge-warning' : '' %>"><%= leave.STATUS_LABEL[r.status] %></span>
                  <% if (r.recommendation !== 'NONE') { %><p class="leave-reco text-sm text-muted">Supervisor: <%= r.recommendation === 'RECOMMEND_APPROVE' ? 'approve' : 'reject' %></p><% } %></td>
                <td><a class="btn btn-secondary btn-sm" href="/leave/<%= r.id %>">Open</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% } %>
