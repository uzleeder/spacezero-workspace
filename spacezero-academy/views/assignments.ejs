<%- include('partials/page-header', { pageTitle: 'Training', pageDescription: 'Assign published training to individuals, a team, or the whole company.' }) %>

<%- include('partials/management-tabs', { tabs: tabsets.training }) %>
<% if (typeof deletedNotice !== 'undefined' && deletedNotice) { %><div class="form-alert success mt-16" role="status"><%= deletedNotice %></div><% } %>
<% if (typeof emailNotice !== 'undefined' && emailNotice) { %><div class="form-alert success mt-16" role="status"><%= emailNotice %></div><% } %>

<div class="grid mt-24" style="grid-template-columns: minmax(0,1fr) 400px">
  <div class="card">
    <div class="card-header"><h2>Recent assignments</h2></div>
    <% if (assignments.length === 0) { %>
      <div class="card-body"><%- include('partials/empty-state', { title: 'No assignments yet', description: 'Use the form to assign a published course.' }) %></div>
    <% } else { %>
      <ul class="divide-list" style="padding:0 24px">
        <% assignments.forEach(function (a) { %>
          <li>
            <p style="font-weight:500;color:var(--navy-950)"><%= a.course.title %></p>
            <p class="text-sm text-muted"><%= a.scope === 'ROLE' && a.targetRole ? 'ROLE · ' + a.targetRole.replace('_', ' ').toLowerCase() : a.scope %> · <%= a._count.recipients %> recipient<%= a._count.recipients === 1 ? '' : 's' %><% if (a.dueDate) { %> · due <%= formatDeadline(a.dueDate) %><% } %></p>
            <% const emails = (a.recipients || []).map(r => r.emailSchedule).filter(Boolean); %>
            <p class="text-sm text-muted mt-4">Email: <%= emails.filter(e => e.assignmentSentAt).length %> accepted for sending<% if (emails.some(e => e.lastError)) { %> · Some emails need attention; temporary failures retry automatically.<% } %></p>
            <div class="mt-8" style="display:flex;gap:8px;flex-wrap:wrap">
              <form method="post" action="/assignments/<%= a.id %>/email" data-once><button type="submit" class="btn btn-secondary btn-sm">Send email</button></form>
              <% if (allowCompany) { %>
              <form method="post" action="/assignments/<%= a.id %>/delete" onsubmit="return confirm('Delete this assigned training (<%= a.course.title.replace(/["'\\]/g, '') %>) for <%= a._count.recipients %> <%= a._count.recipients === 1 ? 'person' : 'people' %>?\n\nIt disappears from their My Training and their attempts on it are removed. Certificates and skill scores already earned stay. This cannot be undone.')"><button type="submit" class="btn btn-danger btn-sm">Delete</button></form>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2>Assign training</h2></div>
    <div class="card-body">
      <% if (error) { %><div class="form-alert error mt-16"><%= error %></div><% } %>
      <% if (courses.length === 0) { %>
        <%- include('partials/empty-state', { title: 'No published courses', description: 'Publish a course under Training Management first.' }) %>
      <% } else { %>
        <form method="post" action="/assignments" data-once>
          <div class="field">
            <label for="courseId">Course</label>
            <select id="courseId" name="courseId" required>
              <% var pre = typeof selectedCourseId !== 'undefined' ? selectedCourseId : ''; %>
              <option value="" disabled <%= courses.some(function (c) { return c.id === pre; }) ? '' : 'selected' %>>Select a course</option>
              <% courses.forEach(function (c) { %><option value="<%= c.id %>" <%= c.id === pre ? 'selected' : '' %>><%= c.title %></option><% }); %>
            </select>
          </div>
          <% if (typeof audienceHint !== 'undefined' && audienceHint && !audienceHint.isEmpty) { %>
            <div class="form-alert info" style="margin-bottom:16px"><strong>Intended audience:</strong> <%= audienceHint.roles.map(roleLabel).concat(audienceHint.teams.map(function (t) { return 'Team ' + t.name; })).concat(audienceHint.people.map(function (p) { return p.fullName; })).join(' · ') %></div>
          <% } %>
          <div class="field">
            <label for="scope">Assign to</label>
            <select id="scope" name="scope" data-scope-select>
              <option value="INDIVIDUAL">Specific people</option>
              <option value="TEAM">One or more teams</option>
              <% if (allowCompany) { %><option value="ROLE">A role group</option><% } %>
              <% if (allowCompany) { %><option value="COMPANY">Company-wide</option><% } %>
            </select>
          </div>
          <div class="field" data-show-for-scope="INDIVIDUAL">
            <p class="label">Recipients</p>
            <div style="max-height:192px;overflow-y:auto;border:1px solid rgba(20,24,31,.1);border-radius:8px;padding:12px">
              <% if (people.length === 0) { %><p class="text-sm text-muted">No one available to assign to.</p><% } %>
              <% people.forEach(function (p) { %>
                <label class="checkbox-row" style="margin-bottom:6px"><input type="checkbox" name="targetProfileIds" value="<%= p.id %>" <%= (typeof selectedPersonId !== 'undefined' && selectedPersonId === p.id) ? 'checked' : '' %> /> <%= p.fullName %></label>
              <% }); %>
            </div>
          </div>
          <div class="field" data-show-for-scope="TEAM">
            <p class="label">Teams</p>
            <div style="max-height:160px;overflow-y:auto;border:1px solid rgba(20,24,31,.1);border-radius:8px;padding:12px">
              <% if (teams.length === 0) { %><p class="text-sm text-muted">No teams available.</p><% } %>
              <% teams.forEach(function (t) { %>
                <label class="checkbox-row" style="margin-bottom:6px"><input type="checkbox" name="targetTeamIds" value="<%= t.id %>" /> <%= t.name %></label>
              <% }); %>
            </div>
          </div>
          <% if (allowCompany) { %>
          <div class="field" data-show-for-scope="ROLE">
            <label for="targetRole">Role group</label>
            <select id="targetRole" name="targetRole">
              <option value="TRAVEL_AGENT">All Travel Agents</option>
              <option value="FLIGHT_EXPERT">All Flight Experts</option>
              <option value="SUPERVISOR">All Supervisors</option>
              <option value="ADMIN">All Admins</option>
            </select>
          </div>
          <% } %>
          <div class="field">
            <label for="dueDate">Due date</label>
            <input id="dueDate" type="date" name="dueDate" value="<%= typeof defaultDueDate !== 'undefined' ? defaultDueDate : '' %>" />
          </div>
          <div class="field"><label for="dueTime">Due time (Tashkent, UTC+05:00)</label><input id="dueTime" type="time" name="dueTime" value="23:59" /><p class="text-sm text-muted">Choose a due date to enable overdue reminders.</p></div>
          <div class="field"><label for="assessmentId">Specific practice (optional)</label><select id="assessmentId" name="assessmentId"><option value="">Complete training</option><% courses.forEach(c => { (c.assessments || []).filter(a => !JSON.parse(a.configJson || '{}').targetedRetake).forEach(a => { %><option value="<%= a.id %>"><%= c.title %> — <%= a.type %>: <%= a.title %></option><% }) }) %></select></div>
          <div class="field"><label for="requiredAttempts">Required attempts</label><input id="requiredAttempts" name="requiredAttempts" type="number" min="1" max="20" value="1"></div>
          <div class="field"><label for="minimumScore">Minimum score (%)</label><input id="minimumScore" name="minimumScore" type="number" min="<%= typeof minimumScoreFloor !== 'undefined' ? minimumScoreFloor : 70 %>" max="100" value="<%= typeof defaultMinimumScore !== 'undefined' ? defaultMinimumScore : 70 %>"></div>
          <div class="field">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="2"></textarea>
          </div>
          <p class="text-sm text-muted">Each recipient gets an assignment email. If unfinished, reminders start 3 hours after the deadline and repeat every 3 hours until completion.</p>
          <button type="submit" class="btn btn-gold mt-16">Assign &amp; send email</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
