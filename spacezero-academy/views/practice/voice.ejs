<%- include('../partials/page-header', { pageTitle: assessment.title, pageDescription: 'Speak your response. Maximum 10 minutes.' }) %>
<section class="card"><div class="card-body"><h2>Your scenario</h2><p><%= config.scenarioBrief %></p><p><strong>Customer:</strong> <%= config.openingLine %></p><p>Skills: <%= (config.rubricSkills || []).join(', ') %></p>
<form method="post" enctype="multipart/form-data" action="/assessments/<%= assessment.id %>/voice" id="voice-form">
<label class="checkbox-row mt-16"><input name="authorized" value="yes" type="checkbox" required> I agree to record my voice and send it to Google Gemini for transcription and practice feedback.</label>
<div class="mt-16"><button type="button" class="btn btn-secondary" id="record-start">Start recording</button> <button type="button" class="btn btn-secondary" id="record-stop" disabled>Stop recording</button></div>
<audio id="voice-preview" class="mt-16" controls hidden></audio><p id="voice-status" role="status"></p>
<div class="field mt-16"><label for="recording">Or upload an audio response (up to 20 MB)</label><input id="recording" type="file" name="recording" accept="audio/webm,audio/wav,audio/mpeg,audio/ogg" required></div>
<button class="btn btn-gold mt-16" id="voice-submit">Submit for feedback</button></form></div></section>
<script src="/static/js/voice-practice.js" defer></script>
