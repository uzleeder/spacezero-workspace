<%- include('../partials/page-header', { pageTitle: 'Result — ' + assessment.title }) %>

<div class="card mt-24">
  <div class="card-body">
    <div style="display:flex;align-items:center;gap:12px">
      <span class="badge <%= passed ? 'badge-success' : 'badge-danger' %>" style="font-size:16px;padding:8px 16px"><%= scoring.overallScore %>%</span>
      <div>
        <p style="font-weight:600;color:var(--navy-950)"><%= passed ? 'Passed' : 'Retake required' %></p>
        <p class="text-sm text-muted">Passing score: <%= assessment.passingScore %>% · Attempt #<%= attempt.attemptNumber %></p>
      </div>
    </div>
    <p class="mt-16"><%= scoring.feedback %></p>
    <% const list = function (v) { return Array.isArray(v) ? v.filter(Boolean) : []; }; %>
    <% if (list(scoring.didWell).length || list(scoring.missed).length || scoring.approachUsed || scoring.wouldHaveWorkedBetter || scoring.nextStep) { %>
      <div class="mt-24" data-debrief>
        <% if (list(scoring.didWell).length) { %><h3 style="font-size:15px;color:var(--navy-950)">What you did well</h3><ul class="mt-8" style="padding-left:18px"><% list(scoring.didWell).forEach(function (t) { %><li><%= t %></li><% }); %></ul><% } %>
        <% if (list(scoring.missed).length) { %><h3 class="mt-16" style="font-size:15px;color:var(--navy-950)">What you missed</h3><ul class="mt-8" style="padding-left:18px"><% list(scoring.missed).forEach(function (t) { %><li><%= t %></li><% }); %></ul><% } %>
        <% if (scoring.approachUsed) { %><h3 class="mt-16" style="font-size:15px;color:var(--navy-950)">The approach you used</h3><p class="mt-8"><%= scoring.approachUsed %></p><% } %>
        <% if (scoring.wouldHaveWorkedBetter) { %><h3 class="mt-16" style="font-size:15px;color:var(--navy-950)">What would have worked better</h3><p class="mt-8"><%= scoring.wouldHaveWorkedBetter %></p><% } %>
        <% if (scoring.nextStep) { %><div class="form-alert info mt-16"><strong>Next time:</strong> <%= scoring.nextStep %></div><% } %>
      </div>
    <% } %>
    <% if (!passed) { %>
      <form method="post" action="/assessments/<%= assessment.id %>/remediate" class="mt-16">
        <button type="submit" class="btn btn-gold">Practice these skills now</button>
      </form>
    <% } %>
  </div>
</div>

<div class="card mt-24">
  <div class="card-header"><h2>Skill scores</h2></div>
  <div class="card-body">
    <% scoring.skillScores.forEach(function (s) { %>
      <div class="mt-16" style="margin-top:14px">
        <div class="row-between" style="margin-bottom:4px">
          <span style="font-weight:500;color:var(--navy-950);font-size:14px"><%= s.skill %></span>
          <span class="text-sm text-muted"><%= s.score %>%</span>
        </div>
        <div class="progress-track"><div class="progress-fill navy" style="width:<%= s.score %>%"></div></div>
      </div>
    <% }); %>
  </div>
</div>

<div class="card mt-24" style="margin-bottom:40px">
  <div class="card-header"><h2>Transcript</h2></div>
  <div class="card-body">
    <ul class="divide-list">
      <% transcript.forEach(function (t) { %>
        <li><span class="text-sm text-muted"><%= t.role === 'agent' ? 'You' : 'Customer' %>:</span> <%= t.text %></li>
      <% }); %>
    </ul>
  </div>
</div>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:40px">
  <% if (assessment.courseId) { %><a href="/training-course/<%= assessment.courseId %>#practice" class="btn <%= passed ? 'btn-gold' : 'btn-secondary' %>"><%= passed ? 'Continue — finish & submit the training' : 'Back to the training' %></a><% } %>
  <a href="/training" class="btn btn-secondary">Back to My Training</a>
</div>
