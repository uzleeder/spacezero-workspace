<%- include('../partials/quiz-guard') %>
<%- include('../partials/page-header', { pageTitle: assessment.title, pageDescription: 'Choose the next action. The situation changes based on your decisions.' }) %>
<section class="card"><div class="card-body"><p class="text-sm">Step <%= state.history.length + 1 %></p><h2><%- gt(node.situation) %></h2><form method="post" action="/assessments/<%= assessment.id %>/process"><input type="hidden" name="sessionId" value="<%= session.id %>"><% node.options.forEach((o,i) => { %><label class="checkbox-row mt-16"><input type="radio" name="choice" value="<%= i %>" required><%- gt(o.label) %></label><% }) %><button class="btn btn-gold mt-24">Continue</button></form></div></section>
