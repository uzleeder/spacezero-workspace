<%#
  No new set of questions could be prepared (the AI failed or today's limit is reached). The only fallback is the
  original practice as it is - the wait after a failed try applies to it as well. Locals: assessment, message, practiceUrl.
%>
<%- include('../partials/page-header', { pageTitle: assessment.title, pageDescription: 'Next try' }) %>

<section class="card mt-24 result-card" style="margin-bottom:40px">
  <div class="card-body">
    <p class="step-eyebrow">Next try</p>
    <h2 class="step-title"><%= message %></h2>
    <p class="step-text">Nothing was lost: your results are saved. You can take the original quiz as it is instead.</p>
  </div>
  <div class="step-actions">
    <a class="step-prev" href="<%= assessment.courseId ? '/training-course/' + assessment.courseId : '/training' %>">← Back to the training</a>
    <a class="btn btn-gold" href="<%= practiceUrl %>" data-result-next>Take the quiz as it is</a>
  </div>
</section>
