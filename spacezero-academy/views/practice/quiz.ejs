<%- include('../partials/quiz-guard') %>
<%- include('../partials/page-header', { pageTitle: assessment.title, pageDescription: assessment.instructions || 'Answer every question, then submit.' }) %>

<% if (typeof error !== 'undefined' && error) { %><div class="form-alert error mt-16" role="alert"><%= error %></div><% } %>

<form method="post" action="/assessments/<%= assessment.id %>/submit">
  <% if (typeof sessionId !== 'undefined' && sessionId) { %><input type="hidden" name="sessionId" value="<%= sessionId %>" /><% } %>
  <% questions.forEach(function (q, i) {
    // What the learner already answered (the quiz comes back filled in when grading was unavailable).
    var given = typeof answers !== 'undefined' && answers ? answers[q.id] : undefined;
    var picked = Array.isArray(given) ? given : (given ? [given] : []); %>
    <div class="card mt-24">
      <div class="card-body">
        <p style="font-weight:500;color:var(--navy-950)"><%= i + 1 %>. <%- gt(q.prompt) %></p>

        <% if (q.type === 'TRUE_FALSE') { %>
          <div class="mt-16" style="display:flex;flex-direction:column;gap:8px">
            <% ['True', 'False'].forEach(function (o) { %>
              <label class="checkbox-row"><input type="radio" name="q_<%= q.id %>" value="<%= o %>" required <%= picked.includes(o) ? 'checked' : '' %> /> <%= o %></label>
            <% }); %>
          </div>
        <% } else if ((q.type === 'MCQ' || q.type === 'SCENARIO' || q.type === 'SHORT_ANSWER') && q.options && q.options.length > 0) { %>
          <div class="mt-16" style="display:flex;flex-direction:column;gap:8px">
            <% q.options.forEach(function (o) { %>
              <label class="checkbox-row"><input type="radio" name="q_<%= q.id %>" value="<%= o %>" required <%= picked.includes(o) ? 'checked' : '' %> /> <%- gt(o) %></label>
            <% }); %>
          </div>
        <% } else if (q.type === 'MULTI_SELECT' || q.type === 'MATCHING') { %>
          <div class="mt-16" style="display:flex;flex-direction:column;gap:8px">
            <% q.options.forEach(function (o) { %>
              <label class="checkbox-row"><input type="checkbox" name="q_<%= q.id %>" value="<%= o %>" <%= picked.includes(o) ? 'checked' : '' %> /> <%- gt(o) %></label>
            <% }); %>
          </div>
        <% } else if (q.type === 'ORDERING') { %>
          <p class="text-sm text-muted mt-16">Put these in the correct order, top to bottom:</p>
          <div class="mt-16" style="display:flex;flex-direction:column;gap:8px">
            <% q.options.forEach(function (o, posIndex) { %>
              <div style="display:flex;align-items:center;gap:8px">
                <span class="text-sm text-muted" style="width:20px"><%= posIndex + 1 %>.</span>
                <select name="q_<%= q.id %>" required style="flex:1">
                  <option value="" disabled <%= picked[posIndex] ? '' : 'selected' %>>Choose...</option>
                  <% q.options.forEach(function (opt) { %><option value="<%= opt %>" <%= picked[posIndex] === opt ? 'selected' : '' %>><%= opt %></option><% }); %>
                </select>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <textarea name="q_<%= q.id %>" rows="3" class="mt-16" placeholder="Type your answer..." required><%= picked[0] || '' %></textarea>
        <% } %>
      </div>
    </div>
  <% }); %>

  <button type="submit" class="btn btn-gold mt-24" style="margin-bottom:40px">Submit</button>
</form>
