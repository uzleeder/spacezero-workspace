<%#
  Shown instead of a practice tried again too soon after a failed try (lib/retakePolicy.js): the countdown, Review the
  material, and Try again by itself once the wait is over. Locals: assessment, block { reason: 'wait', waitMs, until, minutes }.
%>
<%- include('../partials/page-header', { pageTitle: assessment.title, pageDescription: 'Take a short break before the next try' }) %>

<section class="card mt-24 result-card" style="margin-bottom:40px">
  <div class="card-body">
    <p class="step-eyebrow">Next try</p>
    <h2 class="step-title">Go over the material first</h2>
    <p class="step-text">A short pause between tries makes the next one count. When the wait is over, you get a new set of questions on what you missed.</p>
  </div>
  <%- include('../partials/retake-actions', { retakeId: assessment.id, until: block.until, reviewHref: assessment.courseId ? '/training-course/' + assessment.courseId + '?step=1' : '/training', back: { href: '/training', label: '← My Training' } }) %>
</section>
