<!doctype html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=1" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Access denied · SpaceZero Workspace</title>
  <link rel="stylesheet" href="<%= asset('/static/css/styles.css') %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600&display=swap" />
</head>
<body>
  <%- include('partials/error-shell', {
    tone: 'danger',
    iconSvg: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>',
    errorTitle: 'Access denied',
    errorMessage: (typeof profile !== 'undefined' && profile && profile.role === 'SUPERVISOR')
      ? 'Your role does not have permission to view this page. Supervisors only get management access once an administrator grants it — if you need this for your work, ask an administrator to enable it for you under Supervisor Permissions.'
      : 'Your role does not have permission to view this page.',
  }) %>
</body>
</html>
