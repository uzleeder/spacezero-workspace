<%
  // Open the details box whenever the step has anything in it, so an existing explanation / checklist /
  // note is visible straight away while editing instead of hidden behind a click.
  const d = s.detail || {};
  const hasDetails = Boolean(d.explanation || (d.checklist && d.checklist.length) || d.importantNote || d.warning || d.disclosureRefId || d.relatedItemId);
%>
<div class="card" style="padding:12px;margin-bottom:8px" data-repeater-item>
  <div class="row-between" style="gap:8px;align-items:flex-start">
    <div class="field" style="flex:1"><label class="text-sm text-muted">Step title</label><input name="stepTitle" value="<%= s.title || '' %>" maxlength="140" placeholder="Step title" /></div>
    <div style="display:flex;gap:4px">
      <button type="button" class="btn btn-secondary btn-sm" data-move-up title="Move up">↑</button>
      <button type="button" class="btn btn-secondary btn-sm" data-move-down title="Move down">↓</button>
      <button type="button" class="btn btn-secondary btn-sm" data-remove title="Remove">✕</button>
    </div>
  </div>
  <div class="field mt-8"><label class="text-sm text-muted">Instruction</label><textarea name="stepInstruction" rows="2" maxlength="1000" placeholder="Clear instruction — use **bold** for emphasis"><%= s.instruction || '' %></textarea></div>
  <details class="mt-8" <%= hasDetails ? 'open' : '' %>>
    <summary class="text-sm link-gold">Explanation, checklist &amp; notes <span class="text-muted">(optional — the text and bullet list shown under the instruction)</span></summary>
    <div class="field mt-8"><label>Explanation <span class="text-muted">(the line above the list, e.g. “Current examples may include:”)</span></label><textarea name="stepExplanation" rows="2" maxlength="2000"><%= d.explanation || '' %></textarea></div>
    <div class="field mt-8"><label>Checklist <span class="text-muted">(the bullet list — one item per line)</span></label><textarea name="stepChecklist" rows="<%= Math.min(8, Math.max(2, (d.checklist || []).length + 1)) %>" maxlength="2000"><%= (d.checklist || []).join('\n') %></textarea></div>
    <div class="field mt-8"><label>Important note</label><input name="stepImportantNote" value="<%= d.importantNote || '' %>" maxlength="500" /></div>
    <div class="field mt-8"><label>Warning / caution</label><input name="stepWarning" value="<%= d.warning || '' %>" maxlength="500" /></div>
    <div class="grid grid-2 mt-8">
      <div class="field"><label>Related disclosure</label>
        <select name="stepDisclosureRefId">
          <option value="">None</option>
          <% disclosures.forEach(function (x) { %><option value="<%= x.id %>" <%= d.disclosureRefId === x.id ? 'selected' : '' %>><%= x.title %></option><% }); %>
        </select>
      </div>
      <div class="field"><label>Related standard / workflow</label>
        <select name="stepRelatedItemId">
          <option value="">None</option>
          <% relatable.forEach(function (r) { %><option value="<%= r.id %>" <%= d.relatedItemId === r.id ? 'selected' : '' %>><%= r.title %></option><% }); %>
        </select>
      </div>
    </div>
  </details>
</div>
