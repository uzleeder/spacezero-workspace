<%#
  Settings → Advanced → Setup Requirements, kept deliberately simple: the checklist grouped by category, each item
  with its name, one plain line (who needs it · who ticks it off) and one Edit button. "Change order" shows up/down
  arrows that move an item inside its category; removing an item is on its edit page. routes/admin/setupSettings.js.
%>
<%
const CHECKED_BY = { EMPLOYEE_CONFIRMATION: 'the employee ticks it', MANAGEMENT_VERIFICATION: 'employee ticks it, a manager confirms', MANAGEMENT_ONLY: 'only a manager ticks it' };
const groups = [];
requirements.forEach(function (r) {
  const name = r.category || 'Other';
  let g = groups.find(function (x) { return x.name === name; });
  if (!g) { g = { name: name, items: [] }; groups.push(g); }
  g.items.push(r);
});
const whoNeeds = function (r) {
  const mine = targets.filter(function (t) { return t.requirementId === r.id; });
  const people = mine.filter(function (t) { return t.profileId; }).length;
  const teams = mine.filter(function (t) { return t.teamId; }).length;
  const base = r.audience === 'ALL_EMPLOYEES' ? 'Everyone' : r.audience === 'ROLES' ? rolesList(r).map(roleLabel).join(', ') : '';
  const extra = []; if (people) extra.push(people + ' person' + (people === 1 ? '' : 's')); if (teams) extra.push(teams + ' team' + (teams === 1 ? '' : 's'));
  return [base, extra.join(', ')].filter(Boolean).join(' + ') || 'Nobody yet';
};
const headerAction = showArchived
  ? '<a href="/admin/setup-requirements" class="btn btn-secondary">Back to the checklist</a>'
  : '<a href="/admin/setup-requirements/new" class="btn btn-gold">+ Add item</a>';
%>
<%- include('../partials/advanced-page-header', { sectionLabel: 'Setup Requirements', pageTitle: showArchived ? 'Archived items' : 'Setup checklist', pageDescription: showArchived ? 'Items that no longer count. Restore one to put it back on everyone’s checklist.' : 'Everything a new employee needs to start work. Click Edit to change an item.', headerAction: headerAction }) %>

<% if (saved) { %>
  <div class="form-alert success mt-16" role="status">Saved.<% if (applied !== null) { %> It applies to <strong><%= applied %></strong> employee<%= applied === 1 ? '' : 's' %><% if (pending) { %>; <strong><%= pending %></strong> still need<%= pending === 1 ? 's' : '' %> to do it<% } %>.<% } %></div>
<% } %>
<% if (error) { %><div class="form-alert error mt-16" role="alert"><%= error %></div><% } %>

<% if (!showArchived && requirements.length) { %>
  <div class="sc-tools mt-24">
    <span class="text-sm text-muted"><%= requirements.length %> item<%= requirements.length === 1 ? '' : 's' %> in <%= groups.length %> group<%= groups.length === 1 ? '' : 's' %></span>
    <% if (ordering) { %>
      <a href="/admin/setup-requirements" class="btn btn-gold btn-sm">Done</a>
    <% } else { %>
      <a href="/admin/setup-requirements?order=1" class="btn btn-ghost btn-sm">Change order</a>
    <% } %>
  </div>
<% } %>

<% if (!requirements.length) { %>
  <div class="card mt-24"><div class="card-body"><%- include('../partials/empty-state', { title: showArchived ? 'Nothing archived' : 'The checklist is empty', description: showArchived ? 'Items you remove from the checklist wait here.' : 'Add the first thing a new employee needs, for example a Sabre login.' }) %></div></div>
<% } %>

<% groups.forEach(function (g) { %>
  <section class="card sc-group mt-16" aria-labelledby="sc-<%= g.name.replace(/[^A-Za-z0-9]+/g, '-') %>">
    <h2 class="sc-group__title" id="sc-<%= g.name.replace(/[^A-Za-z0-9]+/g, '-') %>"><%= g.name %> <span><%= g.items.length %></span></h2>
    <ul class="sc-list">
      <% g.items.forEach(function (r, i) { const auto = r.kind !== 'MANUAL'; %>
        <li class="sc-item" id="item-<%= r.id %>">
          <div class="sc-item__text">
            <strong><%= r.label %><% if (!r.required) { %> <span class="sc-optional">Optional</span><% } %></strong>
            <span><%= whoNeeds(r) %> · <%= auto ? 'fills in automatically' : CHECKED_BY[r.verification] %></span>
          </div>
          <% if (showArchived) { %>
            <form method="post" action="/admin/setup-requirements/<%= r.id %>/restore"><button class="btn btn-gold btn-sm">Restore</button></form>
          <% } else if (ordering) { %>
            <div class="sc-move">
              <form method="post" action="/admin/setup-requirements/<%= r.id %>/move"><input type="hidden" name="direction" value="up" /><input type="hidden" name="within" value="category" /><button class="btn btn-secondary btn-sm" aria-label="Move <%= r.label %> up" <%= i === 0 ? 'disabled' : '' %>>↑</button></form>
              <form method="post" action="/admin/setup-requirements/<%= r.id %>/move"><input type="hidden" name="direction" value="down" /><input type="hidden" name="within" value="category" /><button class="btn btn-secondary btn-sm" aria-label="Move <%= r.label %> down" <%= i === g.items.length - 1 ? 'disabled' : '' %>>↓</button></form>
            </div>
          <% } else { %>
            <a href="/admin/setup-requirements/<%= r.id %>/edit" class="btn btn-secondary btn-sm" aria-label="Edit <%= r.label %>">Edit</a>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </section>
<% }); %>

<% if (!showArchived) { %>
  <p class="sc-footer mt-24">
    <% if (archivedCount) { %><a href="/admin/setup-requirements?view=archived" class="link-gold text-sm">Archived items (<%= archivedCount %>)</a> · <% } %>
    <a href="/admin/employees" class="link-gold text-sm">See who still needs to finish their setup</a>
  </p>
<% } %>
