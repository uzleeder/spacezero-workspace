<%- include('../partials/page-header', { pageTitle: 'Employees & Teams', pageDescription: 'Each team with its supervisor and members. These relationships decide who can see and manage whom.', headerAction: '<div class="header-actions"><button type="button" class="btn btn-gold" data-dialog-open="create-team-panel" aria-haspopup="dialog">+ Create team</button></div>' }) %>

<%- include('../partials/management-tabs', { tabs: tabsets.employees, sticky: true }) %>

<% if (hierarchy.length === 0) { %>
  <div class="card mt-24"><div class="card-body"><%- include('../partials/empty-state', { title: 'No teams yet', description: 'Create your first team with the Create team button above.' }) %></div></div>
<% } %>

<div class="team-grid mt-24">
  <% hierarchy.forEach(function (row) {
    var team = row.team;
    var members = row.agents.map(function (a) { return { profile: a.profile, supervisor: a.supervisor, supervised: true }; })
      .concat(row.others.map(function (o) { return { profile: o, supervisor: null, supervised: false }; }));
    // Show a member's role only when the team mixes roles; in a one-role team it would repeat on every row.
    var mixedRoles = new Set(members.map(function (m) { return m.profile.role; })).size > 1;
    var ready = members.filter(function (m) { var su = setups.get(m.profile.id); return su && su.fullySetUp; }).length;
    var unsupervised = members.filter(function (m) { return m.supervised && !m.supervisor; }).length;
  %>
    <article class="card team-card<%= team.archivedAt ? ' is-archived' : '' %>">
      <header class="team-card__header">
        <div class="team-card__title">
          <h2><a href="/admin/teams/<%= team.id %>"><%= team.name %></a><% if (team.archivedAt) { %> <span class="badge">Archived</span><% } %></h2>
          <p class="team-card__meta"><%= members.length %> member<%= members.length === 1 ? '' : 's' %> · <%= ready %> of <%= members.length %> fully set up<% if (unsupervised) { %> · <span class="team-card__warn"><%= unsupervised %> without supervisor</span><% } %></p>
        </div>
        <details class="more-menu">
          <summary class="btn btn-ghost btn-sm" aria-label="Actions for <%= team.name %>" title="Team actions">⋯</summary>
          <div class="more-list">
            <a href="/admin/teams/<%= team.id %>">Open team</a>
            <% if (!team.archivedAt) { %><button type="button" class="is-danger" data-action="/admin/teams/<%= team.id %>/archive" data-confirm="Archive this team?">Archive</button><% } %>
            <button type="button" class="is-danger" data-action="/admin/teams/<%= team.id %>/delete" data-success-message="The team was deleted." data-confirm="Delete the team &quot;<%= team.name %>&quot; completely? Its <%= members.length %> member<%= members.length === 1 ? '' : 's' %> will NOT be deleted - they just stop belonging to this team. This cannot be undone.">Delete</button>
          </div>
        </details>
      </header>

      <div class="team-card__lead">
        <% if (row.supervisors.length === 0) { %>
          <p class="team-card__empty">No supervisor in this team yet.</p>
        <% } %>
        <% row.supervisors.forEach(function (s) { %>
          <div class="team-person">
            <a href="/admin/employees/<%= s.id %>" class="team-person__who"><%- include('../partials/avatar', { profile: s, size: 'sm' }) %><span class="team-person__name"><strong><%= s.fullName %></strong><span class="team-person__role">Supervisor</span></span></a>
            <%- include('../partials/setup-mini', { setup: setups.get(s.id) }) %>
          </div>
        <% }); %>
      </div>

      <% if (members.length === 0) { %>
        <p class="team-card__empty team-card__empty--members">No members yet.</p>
      <% } else { %>
        <div class="team-members__head" aria-hidden="true"><span>Members</span><span>Setup</span></div>
        <ul class="team-members">
          <% members.forEach(function (m) { var p = m.profile; %>
            <li class="team-person">
              <a href="/admin/employees/<%= p.id %>" class="team-person__who"><%- include('../partials/avatar', { profile: p, size: 'sm' }) %><span class="team-person__name"><span><%= p.fullName %></span><% if (mixedRoles || !m.supervised) { %><span class="team-person__role"><%= roleLabel(p.role) %></span><% } %></span></a>
              <span class="team-person__end">
                <% if (p.status === 'INVITED') { %><span class="tag">Invited</span><% } %>
                <% if (m.supervised && !m.supervisor) { %><span class="tag tag--warn" title="This member has no supervisor assigned">No supervisor</span><% } else if (m.supervisor && row.supervisors.length && !row.supervisors.some(function (s) { return s.id === m.supervisor.id; })) { %><span class="tag tag--warn" title="Reports to a supervisor outside this team">Supervisor: <%= m.supervisor.fullName %></span><% } %>
                <%- include('../partials/setup-mini', { setup: setups.get(p.id) }) %>
              </span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </article>
  <% }); %>
</div>

<dialog class="drawer" id="create-team-panel" aria-labelledby="create-team-title"<%= error || fieldErrors.name ? ' data-open-on-load' : '' %>>
  <form class="drawer__panel" method="post" action="/admin/teams">
    <div class="drawer__header">
      <h2 id="create-team-title">Create a team</h2>
      <button type="button" class="btn btn-ghost btn-sm" data-dialog-close aria-label="Close">✕</button>
    </div>
    <div class="drawer__body drawer__body--stack">
      <% if (error) { %><div class="form-alert error"><%= error %></div><% } %>
      <div class="field">
        <label for="name">Team name</label>
        <input id="name" name="name" required />
        <% if (fieldErrors.name) { %><p class="error"><%= fieldErrors.name[0] %></p><% } %>
      </div>
      <div class="field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3"></textarea>
      </div>
    </div>
    <div class="drawer__footer">
      <button type="button" class="btn btn-ghost btn-sm" data-dialog-close>Cancel</button>
      <button type="submit" class="btn btn-gold btn-sm">Create team</button>
    </div>
  </form>
</dialog>
