<%
// Role has its own quick-filter buttons, so it isn't counted on the Filters button. Skill range,
// retake, overdue and start-date filters have no chip, so they are counted here.
const panelFilterCount = activeFilters.length - (role ? 1 : 0)
  + [f.skillId, f.min !== null, f.max !== null, f.retake, f.overdue, f.startFrom, f.startTo].filter(Boolean).length;
%>
<%- include('../../partials/page-header', { pageTitle: 'Employees & Teams', pageDescription: 'Every employee’s setup readiness, training, leave and credentials in one place.', headerAction: '<div class="header-actions"><a href="/admin/employees/export.xlsx" class="btn btn-secondary" download title="Employees and Admins sheets: names, usernames, roles and separately supplied export passwords.">Download Excel</a><a href="/admin/employees/new" class="btn btn-gold">+ Add employee</a></div>' }) %>

<%- include('../../partials/management-tabs', { tabs: tabsets.employees, sticky: true }) %>
<% if (typeof removedNotice !== 'undefined' && removedNotice) { %><div class="form-alert success mt-16" role="status"><%= removedNotice %></div><% } %>

<%# One toolbar: search, role, and a Filters button that opens every other filter in a side panel.
    The panel sits inside the same form, so searching keeps the other filters and vice versa. %>
<form class="mgmt-toolbar mt-24" method="get" action="/admin/employees">
  <% if (role) { %><input type="hidden" name="role" value="<%= role %>" /><% } %>
  <%# Filters the list as you type (public/js/employee-directory.js); Enter still searches on the server. %>
  <div class="mgmt-toolbar__search">
    <input type="search" name="q" value="<%= q %>" placeholder="Search by name, username or email…" aria-label="Search employees" autocomplete="off" data-live-search />
  </div>
  <nav class="segmented" aria-label="Role">
    <% [['', 'All employees'], ['ADMIN', 'Admins'], ['SUPERVISOR', 'Supervisors'], ['FLIGHT_EXPERT', 'Flight Experts'], ['TRAVEL_AGENT', 'Travel Agents']].forEach(function (r) { %>
      <a href="/admin/employees<%= r[0] ? '?role=' + r[0] : '' %>" class="segmented__item<%= role === r[0] ? ' is-active' : '' %>"<%- role === r[0] ? ' aria-current="page"' : '' %>><%= r[1] %></a>
    <% }); %>
  </nav>
  <button type="button" class="btn btn-sm <%= panelFilterCount > 0 ? 'btn-gold' : 'btn-secondary' %> mgmt-toolbar__filters" data-dialog-open="employee-filters-panel" aria-haspopup="dialog">Filters<%= panelFilterCount > 0 ? ' (' + panelFilterCount + ')' : '' %></button>

  <dialog class="drawer" id="employee-filters-panel" aria-labelledby="employee-filters-title">
    <div class="drawer__panel">
      <div class="drawer__header">
        <h2 id="employee-filters-title">Filters</h2>
        <button type="button" class="btn btn-ghost btn-sm" data-dialog-close aria-label="Close filters">✕</button>
      </div>
      <div class="drawer__body">
        <p class="drawer__group">People</p>
        <select name="status" aria-label="Employment status">
          <option value="">All employment statuses</option>
          <% [['ACTIVE','Active'],['INVITED','Invited'],['DISABLED','Disabled'],['ARCHIVED','Archived']].forEach(function (s) { %><option value="<%= s[0] %>" <%= status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }); %>
        </select>
        <select name="teamId" aria-label="Team">
          <option value="">All teams</option>
          <% teams.forEach(function (t) { %><option value="<%= t.id %>" <%= teamId === t.id ? 'selected' : '' %>><%= t.name %></option><% }); %>
        </select>
        <select name="supervisorId" aria-label="Supervisor">
          <option value="">All supervisors</option>
          <% supervisors.forEach(function (s) { %><option value="<%= s.id %>" <%= supervisorId === s.id ? 'selected' : '' %>><%= s.fullName %></option><% }); %>
        </select>
        <p class="drawer__group">Setup</p>
        <select name="setup" aria-label="Setup state">
          <option value="">Any setup state</option>
          <% Object.keys(SETUP_FILTERS).forEach(function (k) { %><option value="<%= k %>" <%= setup === k ? 'selected' : '' %>><%= SETUP_FILTERS[k] %></option><% }); %>
        </select>
        <select name="missing" aria-label="Missing item">
          <option value="">Any missing item</option>
          <% requirements.forEach(function (r) { %><option value="<%= r.key %>" <%= missing === r.key ? 'selected' : '' %>>Missing: <%= r.label %></option><% }); %>
        </select>
        <select name="passportStatus" aria-label="Passport status">
          <option value="">Any passport status</option>
          <% Object.values(PASSPORT_STATUS).forEach(function (s) { %><option value="<%= s %>" <%= f.passportStatus === s ? 'selected' : '' %>>Passport: <%= PASSPORT_STATUS_LABEL[s] %></option><% }); %>
        </select>
        <p class="drawer__group">Skills &amp; training</p>
        <%- include('../../partials/employee-filters', { f: f, filterSkills: filterSkills }) %>
      </div>
      <div class="drawer__footer">
        <a href="/admin/employees" class="btn btn-ghost btn-sm">Clear all</a>
        <button type="submit" class="btn btn-gold btn-sm">Apply filters</button>
      </div>
    </div>
  </dialog>
</form>

<% if (activeFilters.length > 0) { %>
  <div class="active-filter-chips mgmt-chips">
    <% activeFilters.forEach(function (chip) { %>
      <a href="<%= chip.href %>" class="filter-chip"><%= chip.label %> <span aria-hidden="true">×</span></a>
    <% }); %>
    <a href="/admin/employees" class="filter-chip filter-chip-clear">Clear all</a>
  </div>
<% } %>

<% if (pendingInvites > 0) { %>
<div class="slim-strip mt-16">
  <span><strong><%= pendingInvites %></strong> employee<%= pendingInvites === 1 ? '' : 's' %> have not activated their account yet.</span>
  <form method="post" action="/admin/employees/invite-pending" onsubmit="return confirm('Create a fresh single-use invitation for every employee who has not activated yet?')"><button type="submit" class="btn btn-gold btn-sm">Invite all pending (<%= pendingInvites %>)</button></form>
</div>
<% } %>

<div class="card mt-16 employee-directory">
  <%# Only the column headings stay pinned while scrolling; search and filters scroll away. %>
  <div class="employee-directory__sticky">
  <div class="employee-directory__heading" aria-hidden="true"></div>
  </div>

  <% if (employees.length === 0) { %>
    <div class="card-body"><%- include('../../partials/empty-state', { title: 'No employees found', description: 'Adjust the filters or add a new employee.' }) %></div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table-zebra">
        <thead><tr><th>Employee</th><th>Status</th><th>Role</th><th>Team</th><th>Supervisor</th><th>Setup</th><th>Training</th><th>Employment</th></tr></thead>
        <tbody>
          <% employees.forEach(function (emp) { %>
            <tr data-href="/admin/employees/<%= emp.id %>" data-search="<%= [emp.fullName, emp.username, emp.email].join(' ').toLowerCase() %>">
              <td><a href="/admin/employees/<%= emp.id %>" style="display:flex;align-items:center;gap:10px">
                <%- include('../../partials/avatar', { profile: emp, size: 'sm', identify: true }) %>
                <div><p style="font-weight:500;color:var(--navy-950)"><%= emp.fullName %></p><p class="text-sm text-muted">@<%= emp.username %></p></div>
              </a></td>
              <td><%- include('../../partials/readiness-badge', { readiness: readinessMap.get(emp.id) }) %></td>
              <td><%= roleLabel(emp.role) %></td>
              <td><%= emp.teamMemberships[0] ? emp.teamMemberships[0].team.name : '—' %></td>
              <td><%= emp.supervisedBy[0] ? emp.supervisedBy[0].supervisor.fullName : '—' %></td>
              <td><%- include('../../partials/setup-badge', { setup: setupMap.get(emp.id), extraTitle: (emp.currentAddressEnc ? 'Address ✓' : 'Address missing') + ' · ' + (emp.localPhone ? 'Phone ✓' : 'Phone missing') }) %></td>
              <td><% const tr = trainingMap.get(emp.id); %><% if (tr.retakeRequired > 0) { %><span class="badge badge-danger"><%= tr.retakeRequired %> retake<%= tr.retakeRequired === 1 ? '' : 's' %></span><% } else if (tr.assigned === 0) { %><span class="text-sm text-muted">Nothing assigned</span><% } else { %><span class="text-sm text-muted"><%= tr.completed %>/<%= tr.assigned %> completed</span><% } %></td>
              <td><span class="badge <%= STATUS_TONE[emp.status] %>"><%= STATUS_LABEL[emp.status] %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="card-body" data-live-empty hidden><%- include('../../partials/empty-state', { title: 'No employees match your search', description: 'Check the spelling, or clear the search box.' }) %></div>
  <% } %>
</div>
<script src="<%= asset('/static/js/employee-directory.js') %>" defer></script>
