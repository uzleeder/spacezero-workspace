<%#
  Add / edit one setup checklist item, in three steps: what it is, who needs it, who ticks it off. Rarely used options
  (owner, due date, position, company-owned accounts) are folded under "More options". Field names are unchanged
  (routes/admin/setupSettings.js readForm). public/js/setup-admin.js makes the people and team lists searchable.
%>
<%
const CHECKED_BY = [
  ['EMPLOYEE_CONFIRMATION', 'The employee ticks it', 'Enough for most tools: the employee confirms they have it.'],
  ['MANAGEMENT_VERIFICATION', 'The employee ticks it, then a manager confirms', 'For things a manager should double-check, like a working company phone.'],
  ['MANAGEMENT_ONLY', 'Only a manager ticks it', 'For things the employee cannot do themselves.'],
];
const manual = !requirement || requirement.kind === 'MANUAL';
const anyTargets = values.profileIds.length || values.teamIds.length;
const moreOpen = values.ownerRole || values.dueDays || values.dueDate || values.companyControlled || values.credentialSystem;
%>
<%- include('../partials/advanced-page-header', { sectionLabel: 'Setup Requirements', pageTitle: mode === 'new' ? 'Add a checklist item' : 'Edit "' + values.label + '"', pageDescription: mode === 'new' ? 'It is added to the setup checklist of everyone it applies to as soon as you save.' : 'Changes apply to the people it concerns straight away.', headerAction: '<a href="/admin/setup-requirements" class="btn btn-secondary">Back to the checklist</a>' }) %>

<% if (errors.length) { %><div class="form-alert error mt-16" role="alert"><% errors.forEach(function (e) { %><p><%= e %></p><% }); %></div><% } %>

<form method="post" action="<%= mode === 'new' ? '/admin/setup-requirements' : '/admin/setup-requirements/' + requirement.id %>" class="mt-24 sr-form" data-setup-form>
  <section class="card">
    <div class="card-header"><h2><span class="lib-step__n">1</span> What is it?</h2></div>
    <div class="card-body">
      <div class="grid grid-2">
        <div class="field"><label for="label">Name</label><input id="label" name="label" value="<%= values.label %>" maxlength="80" required placeholder="e.g. Sabre login" /></div>
        <div class="field">
          <label for="category">Category</label>
          <select id="category" name="category" data-category-select>
            <% categories.forEach(function (c) { %><option value="<%= c %>" <%= values.category === c ? 'selected' : '' %>><%= c %></option><% }); %>
            <% if (values.category && !categories.includes(values.category)) { %><option value="<%= values.category %>" selected><%= values.category %></option><% } %>
            <option value="__new">+ New category…</option>
          </select>
        </div>
        <div class="field" data-new-category hidden><label for="newCategory">New category name</label><input id="newCategory" name="newCategory" maxlength="40" /></div>
      </div>
      <div class="field mt-16"><label for="description">Instructions for the employee <span class="optional">optional</span></label><textarea id="description" name="description" rows="2" maxlength="300" placeholder="e.g. Ask IT for your login on your first day."><%= values.description %></textarea></div>
    </div>
  </section>

  <section class="card mt-24">
    <div class="card-header"><div><h2><span class="lib-step__n">2</span> Who needs it?</h2><p>Only the items someone needs count toward their setup %.</p></div></div>
    <div class="card-body">
      <div class="lib-choice">
        <label class="lib-choice__item"><input type="radio" name="audience" value="ALL_EMPLOYEES" <%= values.audience === 'ALL_EMPLOYEES' ? 'checked' : '' %> /><span><strong>Everyone</strong><small>Every employee, whatever their role.</small></span></label>
        <label class="lib-choice__item"><input type="radio" name="audience" value="ROLES" <%= values.audience === 'ROLES' ? 'checked' : '' %> /><span><strong>Some roles</strong><small>For example only Travel Agents.</small></span></label>
        <div class="sr-roles" data-audience-roles>
          <% ROLES.forEach(function (role) { %><label class="checkbox-row"><input type="checkbox" name="roles" value="<%= role %>" <%= values.roles.includes(role) ? 'checked' : '' %> /> <%= roleLabel(role) %></label><% }); %>
        </div>
        <label class="lib-choice__item"><input type="radio" name="audience" value="SPECIFIC" <%= values.audience === 'SPECIFIC' ? 'checked' : '' %> /><span><strong>Only chosen people or teams</strong><small>Pick them below.</small></span></label>
      </div>

      <details class="sr-targets" data-audience-targets<%= anyTargets || values.audience === 'SPECIFIC' ? ' open' : '' %>>
        <summary>Choose people and teams <span class="text-muted text-sm">(<span data-target-total><%= values.profileIds.length + values.teamIds.length %></span> chosen)</span></summary>
        <p class="hint">They are added on top of the choice above.</p>
        <div class="grid grid-2 mt-16">
          <div class="sr-pick" data-pick>
            <p class="label">People <span class="text-muted text-sm">(<span data-pick-count>0</span> chosen)</span></p>
            <input type="search" placeholder="Find a person" aria-label="Find a person" data-pick-filter />
            <div class="sr-pick__list">
              <% employees.forEach(function (e) { %>
                <label class="checkbox-row" data-pick-item="<%= (e.fullName + ' ' + roleLabel(e.role)).toLowerCase() %>"><input type="checkbox" name="targetProfileIds" value="<%= e.id %>" <%= values.profileIds.includes(e.id) ? 'checked' : '' %> /> <%= e.fullName %> <span class="text-muted text-sm">· <%= roleLabel(e.role) %></span></label>
              <% }); %>
            </div>
          </div>
          <div class="sr-pick" data-pick>
            <p class="label">Teams <span class="text-muted text-sm">(<span data-pick-count>0</span> chosen)</span></p>
            <div class="sr-pick__list">
              <% if (teams.length === 0) { %><p class="text-sm text-muted">No teams yet.</p><% } %>
              <% teams.forEach(function (t) { %>
                <label class="checkbox-row" data-pick-item="<%= t.name.toLowerCase() %>"><input type="checkbox" name="targetTeamIds" value="<%= t.id %>" <%= values.teamIds.includes(t.id) ? 'checked' : '' %> /> <%= t.name %></label>
              <% }); %>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="card mt-24">
    <div class="card-header"><h2><span class="lib-step__n">3</span> Is it required, and who ticks it off?</h2></div>
    <div class="card-body">
      <div class="lib-choice lib-choice--row">
        <label class="lib-choice__item"><input type="radio" name="required" value="required" <%= values.required ? 'checked' : '' %> /><span><strong>Required</strong><small>Counts toward the setup %.</small></span></label>
        <label class="lib-choice__item"><input type="radio" name="required" value="optional" <%= values.required ? '' : 'checked' %> /><span><strong>Optional</strong><small>Shown, but never lowers the setup %.</small></span></label>
      </div>
      <% if (manual) { %>
        <p class="label mt-16">Who ticks it off?</p>
        <div class="lib-choice">
          <% CHECKED_BY.forEach(function (v) { %>
            <label class="lib-choice__item"><input type="radio" name="verification" value="<%= v[0] %>" <%= values.verification === v[0] ? 'checked' : '' %> /><span><strong><%= v[1] %></strong><small><%= v[2] %></small></span></label>
          <% }); %>
        </div>
      <% } else { %>
        <p class="hint mt-16">This item fills in automatically from the employee's own details, so nobody ticks it off.</p>
      <% } %>

      <details class="sr-more mt-16"<%= moreOpen ? ' open' : '' %>>
        <summary>More options <span class="text-muted text-sm">(owner, due date, position<%= manual ? ', company-owned accounts' : '' %>)</span></summary>
        <div class="grid grid-2 mt-16">
          <div class="field">
            <label for="ownerRole">Who is responsible <span class="optional">optional</span></label>
            <select id="ownerRole" name="ownerRole"><option value="">Nobody in particular</option><% [['EMPLOYEE', 'The employee'], ['SUPERVISOR', 'Their supervisor'], ['ADMIN', 'An administrator']].forEach(function (o) { %><option value="<%= o[0] %>" <%= values.ownerRole === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }); %></select>
          </div>
          <div class="field">
            <label for="dueDays">Due within (days after starting) <span class="optional">optional</span></label>
            <input id="dueDays" name="dueDays" type="number" min="0" max="999" value="<%= values.dueDays === null || values.dueDays === undefined ? '' : values.dueDays %>" />
          </div>
          <div class="field">
            <label for="dueDate">…or by a fixed date <span class="optional">replaces the days</span></label>
            <input id="dueDate" name="dueDate" type="date" value="<%= values.dueDate ? new Date(values.dueDate).toISOString().slice(0, 10) : '' %>" />
          </div>
          <div class="field">
            <label for="position">Position in the checklist <span class="optional">optional</span></label>
            <input id="position" name="position" type="number" min="1" max="999" placeholder="<%= mode === 'new' ? 'Blank: at the end' : 'Blank: keep where it is' %>" />
          </div>
        </div>
        <% if (manual) { %>
          <div class="mt-16">
            <label class="checkbox-row sr-check-line"><input type="checkbox" name="companyControlled" value="1" <%= values.companyControlled ? 'checked' : '' %> /> It is a company-owned account or number <span class="text-muted text-sm">— a manager confirms the company owns it and can recover it</span></label>
            <label class="checkbox-row sr-check-line sr-check-line--sub"><input type="checkbox" name="allowPersonalAccount" value="1" <%= values.allowPersonalAccount ? 'checked' : '' %> /> A personal one used for work is also fine</label>
            <label class="checkbox-row sr-check-line"><input type="checkbox" name="credentialSystem" value="1" <%= values.credentialSystem ? 'checked' : '' %> /> Its login must be saved in the Credential Vault</label>
          </div>
        <% } %>
      </details>
    </div>
  </section>

  <div class="row-between mt-24" style="margin-bottom:40px">
    <a href="/admin/setup-requirements" class="text-sm link-gold">Cancel</a>
    <button type="submit" class="btn btn-gold"><%= mode === 'new' ? 'Add to the checklist' : 'Save changes' %></button>
  </div>
</form>

<script>
(function () {
  var form = document.querySelector('[data-setup-form]');
  if (!form) return;
  var select = form.querySelector('[data-category-select]');
  var box = form.querySelector('[data-new-category]');
  function syncCategory() { box.hidden = select.value !== '__new'; }
  select.addEventListener('change', syncCategory); syncCategory();
  var roles = form.querySelector('[data-audience-roles]');
  var targets = form.querySelector('[data-audience-targets]');
  function syncAudience() {
    var mode = form.querySelector('input[name=audience]:checked').value;
    roles.hidden = mode !== 'ROLES';
    roles.querySelectorAll('input').forEach(function (i) { i.disabled = mode !== 'ROLES'; });
    if (mode === 'SPECIFIC') targets.open = true;
  }
  form.querySelectorAll('input[name=audience]').forEach(function (r) { r.addEventListener('change', syncAudience); });
  syncAudience();
  var total = form.querySelector('[data-target-total]');
  form.addEventListener('change', function () { if (total) total.textContent = String(form.querySelectorAll('[name=targetProfileIds]:checked, [name=targetTeamIds]:checked').length); });
  var impactFields = ['audience', 'roles', 'targetProfileIds', 'targetTeamIds', 'required', 'verification'];
  function impactSnapshot() {
    return JSON.stringify(Array.from(new FormData(form)).filter(function (pair) { return impactFields.includes(pair[0]); }));
  }
  var originalImpact = impactSnapshot();
  form.addEventListener('submit', function (event) {
    if (impactSnapshot() !== originalImpact && !window.confirm('Save? The people this item concerns will see their setup % change.')) event.preventDefault();
  });
})();
</script>
<script src="<%= asset('/static/js/setup-admin.js') %>" defer></script>
