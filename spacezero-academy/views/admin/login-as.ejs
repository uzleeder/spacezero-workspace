<%- include('../partials/page-header', { pageTitle: 'Login as', pageDescription: 'Start a real, audited session as another employee to see exactly what they see. Every action while viewing as them is subject to their own permissions and is logged.' }) %>

<div class="tabs no-print">
  <% ['SUPERVISOR', 'TRAVEL_AGENT', 'FLIGHT_EXPERT', 'ADMIN'].forEach(function (r) { %>
    <a class="tab-link<%= role === r ? ' active' : '' %>" href="/admin/login-as?role=<%= r %>"><%= roleLabel(r) %></a>
  <% }); %>
</div>

<div class="card mt-24">
  <% if (role === 'ADMIN') { %>
    <div class="card-body">
      <div class="form-alert info">You are already signed in as an Administrator — impersonating another admin account isn't allowed, to keep audit trails unambiguous.</div>
    </div>
  <% } else if (profiles.length === 0) { %>
    <div class="card-body"><%- include('../partials/empty-state', { title: 'No active ' + roleLabel(role).toLowerCase() + ' accounts', description: 'There are no active employees with this role yet.' }) %></div>
  <% } else { %>
    <ul class="divide-list">
      <% profiles.forEach(function (p) { %>
        <li class="row-between" style="padding:16px 24px">
          <div style="display:flex;align-items:center;gap:12px">
            <%- include('../partials/avatar', { profile: p, size: 'sm' }) %>
            <div>
              <p style="font-weight:500;color:var(--navy-950)"><%= p.fullName %></p>
              <p class="text-sm text-muted">@<%= p.username %></p>
            </div>
          </div>
          <form method="post" action="/admin/login-as/<%= p.id %>">
            <button type="submit" class="btn btn-secondary btn-sm">View as <%= p.fullName.split(' ')[0] %></button>
          </form>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>
