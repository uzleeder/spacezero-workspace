<%- include('../partials/page-header', { pageTitle: 'Company Standards & Workflow', pageDescription: pageDescription }) %>
<% if (profile.role === 'ADMIN') { %><%- include('../partials/management-tabs', { tabs: tabsets.standards }) %><% } %>

<form class="mt-24" action="/standards/search" style="display:flex;gap:12px;margin-bottom:24px">
  <input type="search" name="q" placeholder="Search standards, responsibilities and workflows…" style="flex:1;max-width:420px" />
  <button type="submit" class="btn btn-secondary">Search</button>
</form>

<%# Where am I / what next: derived from the existing acknowledgement records. %>
<% if (progress.required > 0) { %>
<div class="reading-progress mt-16" role="status">
  <div>
    <p class="reading-progress-title"><%= progress.done === progress.required ? 'You have acknowledged all required reading' : 'Required reading: ' + progress.done + ' of ' + progress.required + ' acknowledged' %></p>
    <div class="reading-progress-track" aria-hidden="true"><div class="reading-progress-fill" style="width:<%= Math.round(progress.done / progress.required * 100) %>%"></div></div>
  </div>
  <% if (progress.next) { %><a class="btn btn-gold btn-sm" href="/standards/<%= progress.next.id %>">Continue: <%= progress.next.title %></a><% } %>
</div>
<% } %>

<% if (quickRef.length) { %>
<div class="card mt-16" style="margin-bottom:24px">
  <div class="card-header"><h2>Quick Reference</h2><p>Important everyday rules, at a glance.</p></div>
  <div class="card-body">
    <div class="sz-chips" style="display:flex;flex-wrap:wrap;gap:8px">
      <% quickRef.forEach(function (item) { %>
        <a class="badge badge-gold" href="/standards/<%= item.id %>"><%= item.title %></a>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<%
  const areas = [
    { type: 'STANDARD', href: '/standards/browse/standard', icon: 'book' },
    { type: 'RESPONSIBILITY', href: '/standards/browse/responsibility', icon: 'profile' },
    { type: 'WORKFLOW', href: '/standards/browse/workflow', icon: 'assignments' },
  ];
  if (counts.DISCLOSURE > 0) areas.push({ type: 'DISCLOSURE', href: '/standards/browse/disclosure', icon: 'audit' });
%>
<div class="grid grid-3 mt-16">
  <% areas.forEach(function (a) { %>
  <a class="card card-link area-card" href="<%= a.href %>">
    <%- include('../partials/icon', { name: a.icon }) %>
    <h3 class="mt-16"><%= TYPE_INFO[a.type].label %></h3>
    <p class="text-sm text-muted mt-4"><%= TYPE_INFO[a.type].description %></p>
    <p class="area-card-foot">
      <% if (counts[a.type] === 0) { %><span class="text-muted">Nothing published for you yet</span>
      <% } else { %><span><%= counts[a.type] %> to read</span><% if (todo[a.type] > 0) { %><span class="badge badge-warning"><%= todo[a.type] %> to acknowledge</span><% } %><% } %>
    </p>
  </a>
  <% }); %>
</div>

<% if (profile.role === 'ADMIN' || profile.role === 'SUPERVISOR') { %>
<div class="card mt-24">
  <div class="card-header row-between"><h2>Team acknowledgements</h2><a class="link-gold text-sm" href="/standards/team-status">Open</a></div>
  <div class="card-body"><p class="text-sm text-muted">See who on your team has acknowledged required standards.</p></div>
</div>
<% } %>
