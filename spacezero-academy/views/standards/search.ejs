<%- include('../partials/page-header', { pageTitle: 'Search', pageDescription: 'Company Standards & Workflow', headerAction: '<a href="/standards" class="link-gold text-sm">&larr; Company Standards &amp; Workflow</a>' }) %>

<form class="mt-24" action="/standards/search" style="display:flex;gap:12px;margin-bottom:24px">
  <input type="search" name="q" value="<%= q %>" placeholder="Search standards, responsibilities and workflows…" style="flex:1;max-width:420px" autofocus />
  <button type="submit" class="btn btn-secondary">Search</button>
</form>

<% if (q && results.length === 0) { %>
  <div class="card"><div class="card-body"><%- include('../partials/empty-state', { title: 'No matches found', description: 'Try a different search term. You only see what is published for your role.' }) %></div></div>
<% } else if (results.length) { %>
  <div class="doc-list">
    <% results.forEach(function (item) {
      const v = item.currentVersion;
      const st = states.get(item.id) || { state: 'NONE' };
    %>
      <a class="doc-card" href="/standards/<%= item.id %>">
        <div class="doc-card-main">
          <div class="doc-card-badges">
            <span class="badge"><%= CONTENT_TYPE_LABEL[item.contentType] %></span>
            <% if (v && v.requiredReading) { %><span class="badge badge-gold">Required reading</span><% } %>
            <% if (st.state !== 'NONE') { %><span class="badge <%= st.state === 'DONE' ? 'badge-success' : 'badge-warning' %>"><%= STATE_LABEL[st.state] %></span><% } %>
          </div>
          <h3><%= item.title %></h3>
          <% if (v && v.shortDescription) { %><p class="doc-card-desc"><%= v.shortDescription %></p><% } %>
          <% if (item.category) { %><p class="doc-card-meta"><%= item.category %></p><% } %>
        </div>
        <span class="btn btn-secondary btn-sm doc-card-action">Open &rarr;</span>
      </a>
    <% }); %>
  </div>
<% } %>
