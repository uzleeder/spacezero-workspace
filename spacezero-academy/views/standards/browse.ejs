<%- include('../partials/page-header', { pageTitle: TYPE_INFO[type].label, pageDescription: TYPE_INFO[type].description, headerAction: '<a href="/standards" class="link-gold text-sm">&larr; Company Standards &amp; Workflow</a>' }) %>

<% if (items.length === 0) { %>
  <div class="card mt-24"><div class="card-body"><%- include('../partials/empty-state', { title: TYPE_INFO[type].empty, description: 'When something is published for you it will appear here.' }) %></div></div>
<% } else { %>
  <div class="doc-list mt-24">
    <% items.forEach(function (item) {
      const v = item.currentVersion;
      const st = states.get(item.id) || { state: 'NONE' };
      const roles = rolesList(item);
    %>
      <a class="doc-card" href="/standards/<%= item.id %>">
        <div class="doc-card-main">
          <div class="doc-card-badges">
            <span class="badge"><%= CONTENT_TYPE_LABEL[item.contentType] %></span>
            <% if (v.requiredReading) { %><span class="badge badge-gold">Required reading</span><% } %>
            <% if (item.quickReference) { %><span class="badge badge-gold">Quick ref</span><% } %>
            <% if (st.state !== 'NONE') { %><span class="badge <%= st.state === 'DONE' ? 'badge-success' : 'badge-warning' %>"><%= STATE_LABEL[st.state] %></span><% } %>
          </div>
          <h3><%= item.title %></h3>
          <% if (v.shortDescription) { %><p class="doc-card-desc"><%= v.shortDescription %></p><% } %>
          <p class="doc-card-meta"><% if (roles.length) { %>For <%= roles.map(roleLabel).join(', ') %> · <% } %>Updated <%= (v.publishedAt || item.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
        </div>
        <span class="btn <%= st.state === 'TODO' || st.state === 'UPDATED' ? 'btn-gold' : 'btn-secondary' %> btn-sm doc-card-action"><%= STATE_ACTION[st.state] %> &rarr;</span>
      </a>
    <% }); %>
  </div>
<% } %>
