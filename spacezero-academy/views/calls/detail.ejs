<%- include('../partials/page-header', { pageTitle: 'Call analysis', pageDescription: batch.targetAgent ? batch.targetAgent.fullName : 'Reusable best-practice training' }) %>
<p><a href="/ai-practice" class="text-sm link-gold">← AI Practice</a></p>
<p><span class="badge"><%= batch.status.replaceAll('_', ' ') %></span> <a href="/ai-practice/calls/<%= batch.id %>" class="btn btn-secondary">Refresh status</a></p>
<% if (batch.errorMessage) { %><p role="alert"><%= batch.errorMessage %></p><form method="post" action="/ai-practice/calls/<%= batch.id %>/retry"><button class="btn btn-gold">Retry failed processing</button></form><% } %>
<% batch.recordings.forEach(r => { %><section class="card mt-16"><div class="card-body"><h3><%= r.originalFilename || 'Recording' %></h3><span class="badge"><%= r.status %></span><audio controls preload="none" src="<%= playUrl(r) %>" style="width:100%"></audio><% if (r.errorMessage) { %><p><%= r.errorMessage %></p><% } %><% if (r.transcriptText) { %><details><summary>Redacted transcript</summary><p style="white-space:pre-wrap"><%= r.transcriptText %></p></details><% } %></div></section><% }) %>
<% if (report) { %><section class="card mt-24"><div class="card-body"><h2><%= report.title %></h2><p><%= report.summary %></p><h3>Strengths</h3><ul><% report.strengths.forEach(s => { %><li><%= s %></li><% }) %></ul><h3>Improvement areas</h3><ul><% report.weaknesses.forEach(s => { %><li><%= s %></li><% }) %></ul><h3>Skill evidence</h3><% report.skills.forEach(s => { %><p><strong><%= s.name %> — <%= s.score %>%</strong><br><%= s.evidence %></p><% }) %><h3>Key moments</h3><% report.moments.forEach(m => { %><p><%= Math.floor(m.seconds / 60) %>:<%= String(Math.floor(m.seconds % 60)).padStart(2,'0') %> — <%= m.observation %></p><% }) %></div></section>
<% if (batch.status === 'READY_FOR_REVIEW') { %><section class="card mt-24"><div class="card-body"><h2>Review and customize</h2><form method="post" action="/ai-practice/calls/<%= batch.id %>/approve"><div class="field"><label for="title">Training title</label><input id="title" name="title" value="<%= report.title %>" required maxlength="200"></div><div class="field"><label for="summary">Reviewed lessons</label><textarea id="summary" name="summary" rows="6"><%= report.summary %></textarea></div><% ['QUIZ','ROLEPLAY','VOICE','TECHNICAL','PROCESS_SIM','PRODUCT_KNOWLEDGE'].forEach(m => { %><label class="checkbox-row"><input type="checkbox" name="methods" value="<%= m %>" <%= report.practices.includes(m) ? 'checked' : '' %>><%= m.replaceAll('_',' ') %></label><% }) %><p>Approval creates a draft training package. Review generated exercises, publish, then assign through Training.</p><button class="btn btn-gold">Approve and create practice plan</button></form></div></section><% } %><% } %>
<% if (batch.generatedCourseId) { %><a class="btn btn-gold mt-16" href="/admin/training/<%= batch.generatedCourseId %>">Open training package</a><% } %>
<% if (['FAILED','READY_FOR_REVIEW','APPROVED'].includes(batch.status)) { %><form class="mt-24" method="post" action="/ai-practice/calls/<%= batch.id %>/delete" onsubmit="return confirm('Delete these recordings and transcripts permanently? Generated training is retained.')"><button class="btn btn-danger">Delete recordings and analysis</button></form><% } %>
