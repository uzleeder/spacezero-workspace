# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local SQLite dev db)
/prisma/dev.db
/prisma/dev.db-journal

# uploaded knowledge library files
/storage/

/generated/
/public/uploads/

!.env.production.example

.vercel

# release ZIPs built by npm run package
/dist/
ngrok*.log

# stray server/test run logs
/logs/

# pg_dump output may contain real rows; never committed
*.dump
