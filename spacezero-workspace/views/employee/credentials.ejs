<%- include('../partials/employee-frame') %>

<% if (error) { %><div class="form-alert error mt-16"><%= error %></div><% } %>
<% if (saved) { %><div class="form-alert success mt-16">Saved<%= savedSummary ? ' — ' + savedSummary.created + ' added, ' + savedSummary.updated + ' updated' : '' %>.<% const missing = systemRows.filter(function (s) { return s.required && !s.saved; }); %><%= access.manage ? (missing.length ? ' Still needed for Setup: ' + missing.map(function (s) { return s.label; }).join(', ') + '.' : (systemRows.length ? ' Every required system is saved - the Passwords item in Setup is complete.' : '')) : '' %></div><% } %>

<div class="form-alert info mt-16">
  Credentials are encrypted at rest and masked by default. Revealing one asks for <strong>your own password</strong> again and is recorded in the audit log (the secret itself is never logged).
</div>

<div class="card mt-24">
  <div class="card-header"><h2>Vault entries</h2><p>Work-system logins for <%= employee.fullName %>.</p></div>
  <% if (credentials.length === 0) { %>
    <div class="card-body"><%- include('../partials/empty-state', { title: 'No credentials stored', description: access.manage ? 'Add the first work-system credential below.' : 'Nothing has been added to this vault yet.' }) %></div>
  <% } else { %>
    <ul class="divide-list" style="padding:0 24px">
      <% credentials.forEach(function (c) { %>
        <li data-credential="<%= c.id %>">
          <div class="row-between" style="align-items:flex-start;gap:12px">
            <div>
              <p style="font-weight:500;color:var(--navy-950)"><%= c.system %></p>
              <p class="text-sm text-muted">Login •••••••• · Password •••••••• · updated <%= c.updatedAt.toLocaleDateString('en-US') %></p>
            </div>
            <% if (access.view) { %>
              <form class="reveal-form" data-reveal-url="/credentials/<%= c.id %>/reveal" style="display:flex;gap:6px;align-items:center">
                <input type="password" name="password" placeholder="Your password" autocomplete="current-password" required style="width:150px" />
                <button type="submit" class="btn btn-secondary btn-sm">Reveal</button>
              </form>
            <% } %>
          </div>
          <div class="reveal-output text-sm mt-16" hidden style="background:var(--navy-50, #f4f6fa);border-radius:8px;padding:10px 12px"></div>
          <% if (access.manage) { %>
            <details class="mt-16">
              <summary class="text-sm link-gold" style="cursor:pointer">Edit / delete</summary>
              <form method="post" action="/credentials/<%= c.id %>/update" class="mt-16">
                <div class="grid grid-2">
                  <div class="field"><label>New login / username</label><input name="username" autocomplete="off" /></div>
                  <div class="field"><label>New password</label><input name="password" type="password" autocomplete="new-password" /></div>
                  <div class="field"><label>New account identifier</label><input name="accountId" autocomplete="off" /></div>
                  <div class="field"><label>New secure note</label><input name="note" autocomplete="off" /></div>
                </div>
                <p class="hint">Current values are never sent to this page. Leave a box blank to keep its current value.</p>
                <button type="submit" class="btn btn-secondary btn-sm mt-16">Save changes</button>
              </form>
              <form method="post" action="/credentials/<%= c.id %>/delete" class="mt-16" onsubmit="return confirm('Delete this credential permanently?')">
                <button type="submit" class="btn btn-danger btn-sm">Delete credential</button>
              </form>
            </details>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>

<% if (access.manage && systemRows.length) { %>
  <div class="card mt-24" id="required-systems">
    <div class="card-header"><h2>Required systems</h2><p>Type the login and password for each system, then press <strong>Save all</strong> once. When every required system is saved, "Passwords / Credential Vault" in Setup completes automatically.</p></div>
    <form method="post" action="/employees/<%= employee.id %>/credentials/bulk" autocomplete="off">
      <ul class="divide-list" style="padding:0 24px">
        <% systemRows.forEach(function (s) { %>
        <li style="padding:12px 0">
          <div class="row-between" style="gap:12px;flex-wrap:wrap">
            <strong><%= s.label %><% if (!s.required) { %> <span class="badge" style="margin-left:4px">Optional</span><% } %></strong>
            <span class="badge <%= s.saved ? 'badge-success' : 'badge-warning' %>"><%= s.saved ? 'Saved' : 'Not saved yet' %></span>
          </div>
          <div class="grid grid-2 mt-8">
            <div class="field"><label for="login_<%= s.key %>" class="text-sm">Login / username</label><input id="login_<%= s.key %>" name="login_<%= s.key %>" maxlength="200" autocomplete="off" placeholder="<%= s.saved ? 'Leave blank to keep the saved login' : '' %>" /></div>
            <div class="field"><label for="secret_<%= s.key %>" class="text-sm">Password</label><input id="secret_<%= s.key %>" name="secret_<%= s.key %>" type="password" maxlength="500" autocomplete="new-password" placeholder="<%= s.saved ? 'Leave blank to keep the saved password' : '' %>" /></div>
          </div>
        </li>
        <% }); %>
      </ul>
      <div class="card-body" style="border-top:1px solid var(--border-subtle)">
        <button type="submit" class="btn btn-gold">Save all</button>
        <p class="hint" style="margin-top:8px">Only rows you fill in are saved. Everything is encrypted; saved values are never shown here.</p>
      </div>
    </form>
  </div>
<% } %>

<% if (access.manage) { %>
  <div class="card mt-24">
    <div class="card-header"><h2>Add credential</h2><p>For anything that is not in the list above.</p></div>
    <div class="card-body">
      <form method="post" action="/employees/<%= employee.id %>/credentials" autocomplete="off">
        <div class="grid grid-2">
          <div class="field">
            <label for="system">System</label>
            <select id="system" name="system">
              <option value="">Other (enter name)</option>
              <% systems.forEach(function (s) { %><option value="<%= s.key %>"><%= s.label %></option><% }); %>
            </select>
          </div>
          <div class="field"><label for="customSystem">System name (if Other)</label><input id="customSystem" name="customSystem" maxlength="80" /></div>
          <div class="field"><label for="username">Login / username</label><input id="username" name="username" autocomplete="off" /></div>
          <div class="field"><label for="password">Password / secret</label><input id="password" name="password" type="password" autocomplete="new-password" /></div>
          <div class="field"><label for="accountId">Account identifier</label><input id="accountId" name="accountId" autocomplete="off" /></div>
          <div class="field"><label for="note">Secure note</label><input id="note" name="note" autocomplete="off" /></div>
        </div>
        <p class="hint">Do not store payment-card numbers, CVVs or banking authentication codes here.</p>
        <button type="submit" class="btn btn-gold mt-16">Encrypt &amp; save</button>
      </form>
    </div>
  </div>
<% } %>

<% if (employee.role === 'ADMIN' && isSelf) { %>
  <div class="card mt-24" style="margin-bottom:40px">
    <div class="card-header"><h2>Who else can see my credentials?</h2><p>Admin credentials are never exposed to other roles. Another admin sees them only if you explicitly authorize it.</p></div>
    <div class="card-body">
      <% if (grants.length === 0) { %><p class="text-sm text-muted">No one else has access.</p><% } %>
      <ul class="divide-list">
        <% grants.forEach(function (g) { %>
          <li class="row-between"><span><%= g.grantee.fullName %></span>
            <form method="post" action="/employees/<%= employee.id %>/credentials/grants/<%= g.granteeId %>/delete"><button class="btn btn-danger btn-sm" type="submit">Revoke</button></form></li>
        <% }); %>
      </ul>
      <% if (otherAdmins.length) { %>
        <form method="post" action="/employees/<%= employee.id %>/credentials/grants" class="mt-16" style="display:flex;gap:8px">
          <select name="granteeId" required><% otherAdmins.forEach(function (a) { %><option value="<%= a.id %>"><%= a.fullName %></option><% }); %></select>
          <button class="btn btn-secondary" type="submit">Authorize admin</button>
        </form>
      <% } %>
    </div>
  </div>
<% } %>

<script>
(function () {
  document.querySelectorAll('.reveal-form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var out = form.closest('li').querySelector('.reveal-output');
      var body = new URLSearchParams(new FormData(form));
      fetch(form.getAttribute('data-reveal-url'), { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          form.querySelector('input[name=password]').value = '';
          out.hidden = false;
          out.textContent = '';
          if (!r.ok) { out.textContent = r.data.error || 'Could not reveal.'; return; }
          [['Login', r.data.username], ['Password', r.data.password], ['Account', r.data.accountId], ['Note', r.data.note]].forEach(function (pair) {
            if (!pair[1]) return;
            var line = document.createElement('div');
            line.textContent = pair[0] + ': ' + pair[1];
            out.appendChild(line);
          });
          var note = document.createElement('div');
          note.className = 'text-muted';
          note.textContent = 'Hides automatically in 30 seconds.';
          out.appendChild(note);
          setTimeout(function () { out.textContent = ''; out.hidden = true; }, 30000);
        })
        .catch(function () { out.hidden = false; out.textContent = 'Could not reveal.'; });
    });
  });
})();
</script>
