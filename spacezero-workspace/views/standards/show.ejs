<% if (isPreview) { %>
  <div class="form-alert" style="margin-bottom:16px">Preview — this is how <%= version.status === 'PUBLISHED' ? 'the published version' : 'this draft' %> will look to employees. Nothing here has been saved by viewing it.</div>
<% } %>

<%- include('../partials/page-header', {
  pageTitle: item.title,
  pageDescription: CONTENT_TYPE_LABEL[item.contentType] + (item.category ? ' · ' + item.category : ''),
  headerAction: '<a href="' + (isPreview ? '/admin/standards' : '/standards/browse/' + item.contentType.toLowerCase()) + '" class="link-gold text-sm">&larr; Back</a>',
}) %>

<%
  const stateBadge = ackState ? (!ackState.needed ? ['badge-success', '✓ Acknowledged'] : ackState.stale ? ['badge-warning', 'Updated version — please review'] : ['badge-warning', 'Acknowledgement needed']) : null;
  const when = version.publishedAt || item.updatedAt;
%>
<div class="reader-meta mt-16">
  <span class="badge"><%= CONTENT_TYPE_LABEL[item.contentType] %></span>
  <% if (version.requiredReading) { %><span class="badge badge-gold">Required reading</span><% } %>
  <% if (version.important) { %><span class="badge badge-gold">Featured</span><% } %>
  <% if (stateBadge) { %><span class="badge <%= stateBadge[0] %>"><%= stateBadge[1] %></span><% } %>
  <span class="text-sm text-muted">Updated <%= when.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
</div>

<div class="reader mt-16<%= reader.toc.length ? ' has-toc' : '' %>">
  <% if (reader.toc.length) { %>
  <%# Generated from the document's own headings — there is no separate list to keep up to date. %>
  <nav class="reader-toc" aria-label="On this page">
    <details data-reader-toc>
      <summary>On this page <span aria-hidden="true">▾</span></summary>
      <ol>
        <% reader.toc.forEach(function (t) { %><li><a href="#<%= t.id %>"><%= t.label %></a></li><% }); %>
      </ol>
    </details>
  </nav>
  <% } %>

  <article class="card reader-article">
    <% if (version.shortDescription) { %><p class="reader-lead"><%= version.shortDescription %></p><% } %>

    <% if (item.contentType === 'STANDARD') { %>
      <% blocks.forEach(function (b, i) { var sid = reader.blockIds.get(i); %>
        <% if (b.type === 'heading') { %><h3 id="<%= sid %>"><%- renderInline(b.text) %></h3>
        <% } else if (b.type === 'paragraph') { %><p><%- renderInline(b.text) %></p>
        <% } else if (b.type === 'bullets') { %><ul><% b.items.forEach(function (it) { %><li><%- renderInline(it) %></li><% }); %></ul>
        <% } else if (b.type === 'numbered') { %><ol><% b.items.forEach(function (it) { %><li><%- renderInline(it) %></li><% }); %></ol>
        <% } else if (b.type === 'callout_important') { %><div class="callout-important"><%- renderInline(b.text) %></div>
        <% } else if (b.type === 'callout_warning') { %><div class="callout-warning"><%- renderInline(b.text) %></div>
        <% } %>
      <% }); %>
      <% if (!blocks.length) { %><%- include('../partials/empty-state', { title: 'No content added yet' }) %><% } %>
    <% } %>

    <% if (item.contentType === 'RESPONSIBILITY') { %>
      <% if (!reader.entries.length) { %>
        <%- include('../partials/empty-state', { title: 'No responsibilities added yet' }) %>
      <% } else { %>
        <% if (reader.principle) { %>
          <%# What am I accountable for, in one line: the core principle as a small strip. %>
          <div class="principle-strip">
            <p class="principle-label"><%= reader.principle.label %></p>
            <% if (reader.principle.intro) { %><p class="principle-intro"><%= reader.principle.intro %></p><% } %>
            <ol class="principle-steps"><% reader.principle.steps.forEach(function (s) { %><li><%= s %></li><% }); %></ol>
          </div>
        <% } %>
        <% reader.entries.forEach(function (e) { if (e.asPrinciple) return; %>
          <% if (e.head) { %><h3 id="<%= e.id %>"><%- renderInline(e.head) %></h3><% } %>
          <% if (e.body) { %><p><%- renderInline(e.body) %></p><% } %>
        <% }); %>
      <% } %>
    <% } %>

    <% if (item.contentType === 'WORKFLOW') { %>
      <% if (!reader.steps.length) { %>
        <%- include('../partials/empty-state', { title: 'No steps added yet' }) %>
      <% } else { %>
        <% if (reader.flow) { %>
          <div class="flow-strip">
            <p class="principle-label">The workflow at a glance</p>
            <ol class="flow-steps"><% reader.flow.steps.forEach(function (s) { %><li><%= s %></li><% }); %></ol>
          </div>
          <p class="reader-subhead">Step by step</p>
        <% } %>
        <div class="workflow-steps">
          <% reader.steps.forEach(function (s, i) { %>
            <div class="workflow-step" id="<%= s.id %>">
              <div class="workflow-step-num"><%= s.number %></div>
              <div class="workflow-step-body">
                <h4><%- renderInline(s.title) %></h4>
                <p><%- renderInline(s.instruction) %></p>
                <% if (s.detail && s.detail.explanation) { %><p class="text-sm text-muted"><%- renderInline(s.detail.explanation) %></p><% } %>
                <% if (s.detail && s.detail.checklist && s.detail.checklist.length) { %>
                  <ul class="text-sm" style="padding-left:18px">
                    <% s.detail.checklist.forEach(function (c) { %><li><%- renderInline(c) %></li><% }); %>
                  </ul>
                <% } %>
                <% if (s.detail && s.detail.importantNote) { %><div class="callout-important"><%- renderInline(s.detail.importantNote) %></div><% } %>
                <% if (s.detail && s.detail.warning) { %><div class="callout-warning"><%- renderInline(s.detail.warning) %></div><% } %>
                <% if (s.disclosureRef) { %><p class="text-sm"><a class="link-gold" href="/standards/<%= s.disclosureRef.id %>">See disclosure: <%= s.disclosureRef.title %></a></p><% } %>
                <% if (s.relatedItem) { %><p class="text-sm"><a class="link-gold" href="/standards/<%= s.relatedItem.id %>">Related: <%= s.relatedItem.title %></a></p><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } %>

    <% if (item.contentType === 'DISCLOSURE') { %>
      <% if (version.disclosureWhenItApplies) { %>
        <h3>When it applies</h3>
        <p><%- renderInline(version.disclosureWhenItApplies) %></p>
      <% } %>
      <% if (version.disclosureApprovedWording) { %>
        <h3>Approved wording</h3>
        <div class="disclosure-wording"><%- renderInline(version.disclosureApprovedWording) %></div>
      <% } %>
      <% if (version.disclosureAdditionalInstructions) { %>
        <h3>Additional instructions</h3>
        <p><%- renderInline(version.disclosureAdditionalInstructions) %></p>
      <% } %>
    <% } %>
  </article>
</div>

<% if (ackState) { %>
<div class="card mt-24 reader-ack">
  <div class="card-header"><h2>Acknowledgement</h2></div>
  <div class="card-body">
    <% if (typeof acknowledged !== 'undefined' && acknowledged) { %><div class="form-alert success" style="margin-bottom:16px">Thank you — your acknowledgement has been recorded.</div><% } %>
    <% if (ackState.needed) { %>
      <% if (ackState.stale) { %><p class="reader-ack-note">An updated version is available. Please review it, then acknowledge again.</p><% } %>
      <form method="post" action="/standards/<%= item.id %>/acknowledge">
        <label class="checkbox-row"><input type="checkbox" required /> I have read and understood this <%= CONTENT_TYPE_LABEL[item.contentType].toLowerCase() %> and agree to follow the applicable company requirements.</label>
        <button type="submit" class="btn btn-gold mt-16">Confirm &amp; Accept</button>
      </form>
    <% } else { %>
      <p class="text-sm text-muted">✓ Acknowledged on <%= ackState.acceptedAt.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %><% if (ackState.version && ackState.version !== version.version) { %> (version <%= ackState.version %>) — this update does not need a new acknowledgement<% } %>.</p>
    <% } %>
  </div>
</div>
<% } %>
<script src="<%= asset('/static/js/reader.js') %>" defer></script>
