<%
// Renders the SECTIONS grid (lib/adminConfigurationSections.js) — reused verbatim wherever the
// Advanced configuration surface is shown, currently just the Settings → Advanced tab.
%>
<div class="grid grid-3 advanced-sections">
  <% sections.forEach(function (section) { %>
    <div class="card">
      <div class="card-header"><h2><%= section.title %></h2><p><%= section.description %></p></div>
      <div class="card-body">
        <ul class="divide-list">
          <% section.links.forEach(function (link) { %>
            <li>
              <a class="row-between" href="<%= link.href %>" style="align-items:flex-start">
                <div>
                  <p style="font-weight:500;color:var(--navy-950)"><%= link.label %></p>
                  <p class="text-sm text-muted mt-4"><%= link.description %></p>
                </div>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  <% }); %>
</div>
