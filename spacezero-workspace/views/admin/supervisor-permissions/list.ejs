<%#
  Settings → Advanced → Supervisor Permissions: one table with every Supervisor and what they may do for their own team
  (✓ allowed, — not allowed). The two sensitive permissions are marked with a lock. Click a row to change it.
  routes/admin/supervisorPermissions.js; CAPABILITIES in lib/supervisorCapabilities.js.
%>
<%
const SHORT = { 'setup.view': 'See setup', 'setup.manage': 'Update setup', 'setup.verify': 'Confirm setup', 'credentials.view_team': 'Passwords', 'training.create': 'Create training', 'training.revise': 'Revise training', 'training.assign': 'Assign training', 'training.viewHistory': 'Training history', 'passport.viewNumber': 'Passport no.' };
const SENSITIVE = ['credentials.view_team', 'passport.viewNumber'];
%>
<%- include('../../partials/advanced-page-header', { sectionLabel: 'Supervisor Permissions', pageTitle: 'Supervisor permissions', pageDescription: 'What each Supervisor may do for their own team. A new Supervisor can do nothing until you allow it, and never outside their own team.' }) %>

<%- include('../../partials/how-it-works', { howKey: 'supervisor-permissions', steps: [
  ['Find the Supervisor', 'Each row shows what they may do now: ✓ allowed, — not allowed.'],
  ['Open their row', 'Pick a ready-made set (for example "Team lead") or tick single permissions.'],
  ['Careful with 🔒', 'Passwords and passport numbers are sensitive. They are never part of a ready-made set.'],
] }) %>

<% if (saved) { %><div class="form-alert success mt-16" role="status">Saved.</div><% } %>

<% if (supervisors.length === 0) { %>
  <div class="card mt-24"><div class="card-body"><%- include('../../partials/empty-state', { title: 'No Supervisors yet', description: 'Supervisors appear here once someone has the Supervisor role.' }) %></div></div>
<% } else { %>
  <div class="card mt-24">
    <div class="table-wrap sp-wrap">
      <table class="table sp-table">
        <thead>
          <tr>
            <th scope="col">Supervisor</th>
            <% CAPABILITIES.forEach(function (c) { %><th scope="col" title="<%= c.label %>"><%= SHORT[c.key] || c.label %><%= SENSITIVE.includes(c.key) ? ' 🔒' : '' %></th><% }); %>
            <th scope="col"><span class="visually-hidden">Change</span></th>
          </tr>
        </thead>
        <tbody>
          <% supervisors.forEach(function (s) { const granted = grantsBySupervisor.get(s.id) || new Set(); %>
            <tr data-href="/admin/supervisor-permissions/<%= s.id %>">
              <th scope="row"><a href="/admin/supervisor-permissions/<%= s.id %>" class="sp-name"><%= s.fullName %></a><span class="sp-user">@<%= s.username %> · <%= granted.size ? granted.size + ' of ' + CAPABILITIES.length : 'Nothing yet' %></span></th>
              <% CAPABILITIES.forEach(function (c) { const on = granted.has(c.key); %>
                <td class="sp-cell<%= on ? ' is-on' : '' %><%= on && SENSITIVE.includes(c.key) ? ' is-sensitive' : '' %>"><span aria-hidden="true"><%= on ? '✓' : '—' %></span><span class="visually-hidden"><%= c.label %>: <%= on ? 'allowed' : 'not allowed' %></span></td>
              <% }); %>
              <td class="sp-go"><a href="/admin/supervisor-permissions/<%= s.id %>" class="btn btn-secondary btn-sm">Change</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
