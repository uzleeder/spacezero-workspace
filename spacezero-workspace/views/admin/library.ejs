<%#
  Manage library (Admins). The list of materials with their category and who can see them, and two side panels:
  "Add material" (three short steps: what it is, describe it, who can see it) and "Categories" (add, rename, remove).
  routes/admin/library.js; after a mistake the add panel opens again with what was typed.
%>
<%
const f = form || {};
const source = f.source || 'file';
const audience = f.audience === 'some' ? 'some' : 'everyone';
const picked = Array.isArray(f.visibleRoles) ? f.visibleRoles : f.visibleRoles ? [f.visibleRoles] : [];
const headerAction = '<div class="row-gap"><button type="button" class="btn btn-secondary" data-dialog-open="lib-categories" aria-haspopup="dialog">Categories</button>' +
  '<button type="button" class="btn btn-gold" data-dialog-open="lib-add" aria-haspopup="dialog">+ Add material</button></div>';
%>
<%- include('../partials/page-header', { pageTitle: 'Manage library', pageDescription: 'Add reference material for your team and decide who can see it.', headerAction: headerAction }) %>

<%- include('../partials/management-tabs', { tabs: tabsets.library }) %>

<%- include('../partials/how-it-works', { howKey: 'library', steps: [
  ['Add material', 'Upload a file, paste a link, or write a short note.'],
  ['Give it a category', 'People browse the Library by category, so choose the closest one.'],
  ['Choose who can see it', 'Everyone, or only some roles. You can change this later.'],
] }) %>

<% if (saved === 'added') { %><div class="form-alert success mt-16" role="status">Added to the Library.</div><% } %>

<div class="card mt-24">
  <div class="card-header row-between">
    <div><h2>Materials</h2><p><%= items.length %> in the Library</p></div>
    <% if (items.length > 6) { %><input type="search" class="lib-admin-search" placeholder="Find a material" aria-label="Find a material" data-table-filter="lib-table" /><% } %>
  </div>
  <% if (!items.length) { %>
    <div class="card-body">
      <%- include('../partials/empty-state', { title: 'No materials yet', description: 'Add the first guide, video or link for your team.' }) %>
      <p class="text-center mt-16"><button type="button" class="btn btn-gold" data-dialog-open="lib-add">+ Add material</button></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table lib-table" id="lib-table">
        <thead><tr><th>Material</th><th>Category</th><th>Who can see it</th><th>Views</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <tr data-filter-text="<%= (item.title + ' ' + (item.category ? item.category.name : '')).toLowerCase() %>">
              <td data-label="Material"><a href="/admin/library/items/<%= item.id %>" class="lib-table__title"><%= item.title %></a><span class="lib-table__type"><%= TYPE_LABELS[item.itemType] || item.itemType %></span></td>
              <td data-label="Category"><%= item.category ? item.category.name : 'No category' %></td>
              <td data-label="Who can see it"><span class="pill<%= item.visibleRolesJson ? ' pill--muted' : '' %>"><%= audienceLabel(item.visibleRolesJson) %></span></td>
              <td data-label="Views"><%= item.viewCount %></td>
              <td class="lib-table__actions">
                <a class="btn btn-secondary btn-sm" href="/admin/library/items/<%= item.id %>">Edit</a>
                <button type="button" class="btn btn-ghost btn-sm" data-action="/admin/library/items/<%= item.id %>/archive" data-confirm="Archive &quot;<%= item.title %>&quot;? It disappears from the Library; nothing is deleted.">Archive</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%# ---- Add material ---- %>
<dialog class="drawer lib-drawer" id="lib-add" aria-labelledby="lib-add-title"<%= panel === 'add' ? ' data-open-on-load' : '' %>>
  <form class="drawer__panel" method="post" action="/admin/library/items" enctype="multipart/form-data" data-lib-add>
    <div class="drawer__header">
      <h2 id="lib-add-title">Add material</h2>
      <button type="button" class="btn btn-ghost btn-sm" data-dialog-close aria-label="Close">✕</button>
    </div>
    <div class="drawer__body lib-steps">
      <% if (error) { %><div class="form-alert error" role="alert"><%= error %></div><% } %>

      <fieldset class="lib-step">
        <legend><span class="lib-step__n">1</span> What are you adding?</legend>
        <div class="lib-choice" role="radiogroup">
          <label class="lib-choice__item"><input type="radio" name="source" value="file"<%= source === 'file' ? ' checked' : '' %> data-lib-source /><span><strong>A file</strong><small>Video, audio, PDF, slides, Word or image</small></span></label>
          <label class="lib-choice__item"><input type="radio" name="source" value="link"<%= source === 'link' ? ' checked' : '' %> data-lib-source /><span><strong>A link</strong><small>A web page or online tool</small></span></label>
          <label class="lib-choice__item"><input type="radio" name="source" value="note"<%= source === 'note' ? ' checked' : '' %> data-lib-source /><span><strong>A short note</strong><small>A few lines of text</small></span></label>
        </div>
        <div data-lib-for="file">
          <%- include('../partials/dropzone', { inputId: 'lib-file', inputName: 'file', accept: '.mp4,.webm,.mov,.mp3,.wav,.ogg,.m4a,.pdf,.ppt,.pptx,.doc,.docx,.png,.jpg,.jpeg,.webp,.gif', hint: 'The type (video, PDF, …) is recognised from the file.' }) %>
        </div>
        <div class="field" data-lib-for="link">
          <label for="lib-url">Link</label>
          <input id="lib-url" name="externalUrl" type="url" placeholder="https://" value="<%= f.externalUrl || '' %>" />
          <p class="hint">YouTube videos play right inside the Library.</p>
        </div>
        <div class="field" data-lib-for="note">
          <label for="lib-note">Note</label>
          <textarea id="lib-note" name="noteText" rows="5" placeholder="Write the note people will read"><%= f.noteText || '' %></textarea>
        </div>
      </fieldset>

      <fieldset class="lib-step">
        <legend><span class="lib-step__n">2</span> Describe it</legend>
        <div class="field">
          <label for="lib-title">Title</label>
          <input id="lib-title" name="title" required minlength="2" value="<%= f.title || '' %>" placeholder="e.g. Emirates A380 First Class suite" />
        </div>
        <div class="field">
          <label for="lib-category">Category</label>
          <select id="lib-category" name="categoryId">
            <option value="">No category</option>
            <% categories.forEach(function (c) { %><option value="<%= c.id %>"<%= f.categoryId === c.id ? ' selected' : '' %>><%= c.name %></option><% }); %>
          </select>
          <p class="hint">Missing one? Add it under <button type="button" class="link-btn" data-dialog-open="lib-categories">Categories</button>.</p>
        </div>
        <div class="field" data-lib-for="file link">
          <label for="lib-desc">Short description <span class="optional">optional</span></label>
          <textarea id="lib-desc" name="description" rows="2" placeholder="What will people learn or find here?"><%= f.description || '' %></textarea>
        </div>
        <div class="field">
          <label for="lib-tags">Search words <span class="optional">optional</span></label>
          <input id="lib-tags" name="tags" value="<%= f.tags || '' %>" placeholder="business class, A380" />
          <p class="hint">Separate with commas. They help people find it.</p>
        </div>
      </fieldset>

      <fieldset class="lib-step">
        <legend><span class="lib-step__n">3</span> Who can see it?</legend>
        <div class="lib-choice lib-choice--row" role="radiogroup">
          <label class="lib-choice__item"><input type="radio" name="audience" value="everyone"<%= audience === 'everyone' ? ' checked' : '' %> data-lib-audience /><span><strong>Everyone</strong></span></label>
          <label class="lib-choice__item"><input type="radio" name="audience" value="some"<%= audience === 'some' ? ' checked' : '' %> data-lib-audience /><span><strong>Only some roles</strong></span></label>
        </div>
        <div class="lib-roles" data-lib-roles>
          <% Object.keys(ROLE_LABELS).forEach(function (r) { %><label class="checkbox-row"><input type="checkbox" name="visibleRoles" value="<%= r %>"<%= picked.includes(r) ? ' checked' : '' %> /> <%= ROLE_LABELS[r] %></label><% }); %>
        </div>
      </fieldset>
    </div>
    <div class="drawer__footer">
      <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
      <button type="submit" class="btn btn-gold">Add to Library</button>
    </div>
  </form>
</dialog>

<%# ---- Categories ---- %>
<dialog class="drawer lib-drawer" id="lib-categories" aria-labelledby="lib-cat-title"<%= panel === 'categories' ? ' data-open-on-load' : '' %>>
  <div class="drawer__panel">
    <div class="drawer__header">
      <h2 id="lib-cat-title">Categories</h2>
      <button type="button" class="btn btn-ghost btn-sm" data-dialog-close aria-label="Close">✕</button>
    </div>
    <div class="drawer__body lib-steps">
      <p class="text-sm text-muted">People browse the Library by these. Rename one by editing its name; a category can be removed once no material uses it.</p>
      <% if (catError) { %><div class="form-alert error" role="alert"><%= catError %></div><% } %>
      <ul class="lib-catlist">
        <% categories.forEach(function (c) { %>
          <li>
            <form method="post" action="/admin/library/categories/<%= c.id %>" class="lib-catlist__rename">
              <input name="name" value="<%= c.name %>" aria-label="Name of <%= c.name %>" required minlength="2" />
              <span class="lib-catlist__count"><%= c.count %> material<%= c.count === 1 ? '' : 's' %></span>
              <button type="submit" class="btn btn-secondary btn-sm">Save</button>
            </form>
            <form method="post" action="/admin/library/categories/<%= c.id %>/delete" data-confirm-submit="Remove the category &quot;<%= c.name %>&quot;?">
              <button type="submit" class="btn btn-ghost btn-sm" <%= c.count ? 'disabled title="Move its materials to another category first"' : '' %>>Remove</button>
            </form>
          </li>
        <% }); %>
      </ul>
      <form method="post" action="/admin/library/categories" class="lib-catlist__add">
        <label for="lib-newcat">New category</label>
        <div class="row-gap"><input id="lib-newcat" name="name" required minlength="2" placeholder="e.g. Visa rules" /><button type="submit" class="btn btn-gold">Add</button></div>
      </form>
    </div>
  </div>
</dialog>
<script src="<%= asset('/static/js/library-admin.js') %>" defer></script>
