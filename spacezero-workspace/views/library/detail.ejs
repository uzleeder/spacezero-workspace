<%- include('../partials/page-header', { pageTitle: item.title, pageDescription: item.category ? item.category.name : 'Uncategorized', headerAction: '<button type="button" class="btn btn-secondary' + (isFavorite ? ' is-active' : '') + '" data-favorite-toggle="' + item.id + '" data-favorite-label aria-pressed="' + (isFavorite ? 'true' : 'false') + '">' + (isFavorite ? '★ In My Library' : '☆ Add to My Library') + '</button>' }) %>

<div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
  <span class="badge badge-navy"><%= item.itemType %></span>
  <% parseTags(item.tagsJson).forEach(function (tag) { %><span class="badge"><%= tag %></span><% }); %>
</div>

<div class="card">
  <div class="card-body<%= protect ? ' no-copy' : '' %>" <%- protect ? 'data-protect' : '' %>>
    <% if (item.description && item.itemType !== 'NOTE') { %><p class="text-sm" style="margin-bottom:16px"><%= item.description %></p><% } %>

    <% if (item.itemType === 'LINK' && item.externalUrl) { %>
      <a href="<%= item.externalUrl %>" target="_blank" rel="noopener noreferrer" class="link-gold" style="font-weight:500">Open link &rarr;</a>
    <% } else if (item.itemType === 'NOTE') { %>
      <p style="white-space:pre-wrap"><%= item.description %></p>
    <% } else { %>
      <%- include('../partials/material-viewer', { kind: kind, fileUrl: '/library-file/' + item.id, text: text, protect: protect, title: item.title }) %>
    <% } %>

    <% if (protect) { %>
      <p class="text-sm text-muted mt-24">Viewing in-browser only. Downloading and copying materials is restricted to administrators.</p>
    <% } else if (item.storagePath) { %>
      <p class="text-sm mt-24"><a class="link-gold" href="/library-file/<%= item.id %>?download=1">Download (administrators only)</a></p>
    <% } %>
  </div>
</div>
<% if (protect) { %><script src="<%= asset('/static/js/protect-materials.js') %>" defer></script><% } %>
